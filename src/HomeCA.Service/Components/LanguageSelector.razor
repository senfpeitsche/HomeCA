@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text
@using HomeCA.Service.Localization

<MudMenu Icon="@Icons.Material.Filled.Translate"
         Color="Color.Inherit"
         Dense="true"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         AriaLabel="@Text["LanguageSelectorLabel"]">
    @foreach (var locale in LocaleCatalog.Locales)
    {
        <MudMenuItem OnClick="@(() => SelectCultureAsync(locale.Culture))">
            <div class="appearance-option">
                <span>@locale.DisplayName</span>
                @if (locale.Culture == ActiveCulture)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                }
            </div>
        </MudMenuItem>
    }
</MudMenu>

@code {
    private string ActiveCulture => LocaleCatalog.NormalizeOrDefault(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);

    private async Task SelectCultureAsync(string culture)
    {
        var selected = LocaleCatalog.NormalizeOrDefault(culture);
        if (selected == ActiveCulture) return;
        await JS.InvokeVoidAsync("homeca.setCulture", selected);
    }
}
