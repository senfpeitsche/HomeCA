@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> UiText

<div class="script-preview script-preview-static" style="--code-preview-lines: @Lines">
    <pre><code>@Text</code></pre>
    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@EffectiveCopyLabel" OnClick="CopyAsync" />
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public int Lines { get; set; } = 3;
    [Parameter] public string? CopyLabel { get; set; }
    private string EffectiveCopyLabel => CopyLabel ?? UiText["CopyCode"];

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("homeca.copyToClipboard", Text);
        Snackbar.Add(UiText["TrustInstallCopied"], Severity.Success);
    }
}
