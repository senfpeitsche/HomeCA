@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject HomeCaInternalHttpClient InternalHttpClient
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text

<main class="login-shell">
    <MudPaper Class="login-card" Elevation="0" Style="max-width: 640px;">
        <MudText Typo="Typo.overline" Class="signal-text">@Text["SetupKicker"]</MudText>
        <MudText Typo="Typo.h4" Class="service-title mb-2">@Text["SetupTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">
            @Text["SetupDescription"]
        </MudText>

        @* Progress indicator *@
        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-4">
            <MudTimelineItem Color="@StepColor(0)" Size="Size.Small">
                <MudText Typo="Typo.body2" Style="@StepStyle(0)">@Text["SetupHostnameStep"]</MudText>
            </MudTimelineItem>
            <MudTimelineItem Color="@StepColor(1)" Size="Size.Small">
                <MudText Typo="Typo.body2" Style="@StepStyle(1)">@Text["SetupConnectorStep"]</MudText>
            </MudTimelineItem>
            <MudTimelineItem Color="@StepColor(2)" Size="Size.Small">
                <MudText Typo="Typo.body2" Style="@StepStyle(2)">@Text["SetupCaStep"]</MudText>
            </MudTimelineItem>
        </MudTimeline>

        <MudDivider Class="mb-4" />

        @* ── Step 1: Hostname / PublicUrl ──────────────────────────────── *@
        @if (_step == 0)
        {
            <MudText Typo="Typo.h6" Class="mb-2">@Text["SetupHostnameTitle"]</MudText>
            <MudText Class="mud-text-secondary mb-3">
                @Text["SetupHostnameDescription"]
            </MudText>

            <MudForm @ref="_hostnameForm" @bind-IsValid="_hostnameValid">
                <MudTextField @bind-Value="_hostname" Label="@Text["SetupHostnameLabel"]" Placeholder="homeca.home.local"
                    Required="true" RequiredError="@Text["SetupHostnameRequired"]"
                    Validation="@(new Func<string, string?>(ValidateHostname))"
                    Immediate="true" HelperText="@Text["SetupHostnameHelper"]" />
                <MudNumericField T="int" @bind-Value="_port" Label="@Text["SetupPortLabel"]" Min="1" Max="65535"
                    HelperText="@Text["SetupPortHelper"]" Class="mt-2" />
            </MudForm>

            @if (_hostnameConfigured)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3 mb-3">
                    @Text["SetupPublicUrlConfigured", _hostname, _port]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _step = 1)" FullWidth="true">
                    @Text["SetupContinueConnector"]
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                    Disabled="@(!_hostnameValid || _busy)" OnClick="ConfigureHostnameAsync" FullWidth="true" Class="mt-3">
                    @(_busy ? Text["SetupSaving"] : Text["SetupApplyHostname"])
                </MudButton>
            }
        }

        @* ── Step 2: Optional DNS Connector ───────────────────────────── *@
        else if (_step == 1)
        {
            <MudText Typo="Typo.h6" Class="mb-2">@Text["SetupConnectorTitle"]</MudText>
            <MudText Class="mud-text-secondary mb-3">
                @Text["SetupConnectorDescription"]
            </MudText>

            @if (!_showConnectorForm)
            {
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _showConnectorForm = true)">
                        @Text["SetupConnectorNow"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _step = 2)">
                        @Text["SetupConnectorSkipLater"]
                    </MudButton>
                </div>
            }
            else
            {
                <MudSelect T="string" Label="@Text["SetupConnectorType"]" @bind-Value="_connectorType" Class="mb-2">
                    <MudSelectItem Value="@("technitium")">Technitium DNS</MudSelectItem>
                    <MudSelectItem Value="@("hetzner")">Hetzner DNS</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_connectorName" Label="@Text["SetupConnectorName"]" Placeholder="@Text["SetupConnectorNamePlaceholder"]"
                    Required="true" Immediate="true" Class="mb-2" />

                @if (_connectorType == "technitium")
                {
                    <MudTextField @bind-Value="_connectorEndpoint" Label="@Text["SetupApiEndpoint"]"
                        Placeholder="http://10.0.0.1:5380" Required="true" Immediate="true" Class="mb-2"
                        HelperText="@Text["SetupTechnitiumApiUrl"]" />
                    <MudTextField @bind-Value="_connectorSecret" Label="@Text["SetupApiToken"]"
                        InputType="InputType.Password" Required="true" Immediate="true"
                        HelperText="@Text["SetupTechnitiumApiToken"]" />
                }
                else
                {
                    <MudTextField @bind-Value="_connectorSecret" Label="@Text["SetupHetznerApiToken"]"
                        InputType="InputType.Password" Required="true" Immediate="true"
                        HelperText="@Text["SetupHetznerApiTokenHelper"]" />
                }

                @if (!string.IsNullOrEmpty(_connectorError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_connectorError</MudAlert>
                }
                @if (_connectorCreated)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2 mb-3">@Text["SetupConnectorSaved"]</MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _step = 2)" FullWidth="true">
                        @Text["SetupContinueCa"]
                    </MudButton>
                }
                else
                {
                    <div class="d-flex gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                            Disabled="@(_busy || string.IsNullOrWhiteSpace(_connectorName) || string.IsNullOrWhiteSpace(_connectorSecret))"
                            OnClick="CreateConnectorAsync">
                            @(_busy ? Text["SetupSaving"] : Text["SetupConnectorSave"])
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="@(() => { _showConnectorForm = false; _step = 2; })">
                            @Text["SetupSkip"]
                        </MudButton>
                    </div>
                }
            }
        }

        @* ── Step 3: Create CA ────────────────────────────────────────── *@
        else if (_step == 2)
        {
            <MudText Typo="Typo.h6" Class="mb-2">@Text["SetupCaTitle"]</MudText>
            <MudText Class="mud-text-secondary mb-3">
                @Text["SetupCaDescription"]
            </MudText>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @Text["SetupCrlUrl"] <strong>http://@_hostname:@_port/api/v1/crl/latest</strong>
            </MudAlert>

            @if (_caCreated)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    @Text["SetupCaCreated"] @Text["SetupCaReady"]
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinishAsync" Disabled="_busy" FullWidth="true">
                    @(_busy ? Text["SetupLoading"] : Text["SetupDashboard"])
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="InitializeCaAsync" FullWidth="true">
                    @(_busy ? Text["SetupCreatingCa"] : Text["SetupCreateCa"])
                </MudButton>
            }
        }

        <MudDivider Class="my-4" />
        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="SkipWizardAsync" Disabled="_busy">
            @Text["SetupSkipAssistant"]
        </MudButton>
    </MudPaper>
</main>

@code {
    [Parameter] public string Token { get; set; } = "";
    [Parameter] public EventCallback OnSetupComplete { get; set; }
    [Parameter] public EventCallback OnSkipped { get; set; }
    [Parameter] public string InitialPhase { get; set; } = "initial";

    private readonly JsonSerializerOptions _json = new(JsonSerializerDefaults.Web);
    private int _step;
    private bool _busy;

    // Step 1: Hostname
    private string _hostname = "";
    private int _port = 5080;
    private bool _hostnameValid, _hostnameConfigured;
    private MudForm? _hostnameForm;

    // Step 2: DNS Connector
    private bool _showConnectorForm, _connectorCreated;
    private string _connectorType = "technitium", _connectorName = "", _connectorSecret = "", _connectorEndpoint = "", _connectorError = "";

    // Step 3: CA
    private bool _caCreated;

    // Timeline helpers
    private Color StepColor(int s) => s < _step ? Color.Success : s == _step ? Color.Primary : Color.Default;
    private string StepStyle(int s) => s == _step ? "font-weight: bold;" : s < _step ? "opacity: 0.6;" : "opacity: 0.4;";

    private static readonly System.Text.RegularExpressions.Regex HostnamePattern = new(
        @"^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z]{2,}$",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    protected override void OnInitialized()
    {
        _step = InitialPhase switch
        {
            "cainitialized" or "tlsconfigured" or "complete" => 2,
            "passwordchanged" => 0,
            _ => 0
        };
        _caCreated = InitialPhase is "cainitialized" or "tlsconfigured" or "complete";
    }

    private HttpClient Client()
    {
        var client = InternalHttpClient.Create(new Uri(Navigation.BaseUri));
        if (!string.IsNullOrEmpty(Token))
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Token);
        return client;
    }

    private string? ValidateHostname(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (value.Contains(' ')) return Text["SetupHostnameSpaces"];
        if (value.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return Text["SetupHostnameNoUrl"];
        if (!HostnamePattern.IsMatch(value)) return Text["SetupHostnameInvalid"];
        return null;
    }

    // ── Step 1: Configure hostname ─────────────────────────────────────
    private async Task ConfigureHostnameAsync()
    {
        if (_hostnameForm is not null) { await _hostnameForm.Validate(); if (!_hostnameValid) return; }
        if (string.IsNullOrWhiteSpace(_hostname)) return;

        _busy = true;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/setup/configure", new { hostname = _hostname, port = _port });
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(Text["SetupHostnameSaveFailed"], Severity.Error);
                return;
            }
            _hostnameConfigured = true;
            Snackbar.Add(Text["SetupPublicUrlSaved", _hostname, _port], Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    // ── Step 2: Create DNS connector ───────────────────────────────────
    private async Task CreateConnectorAsync()
    {
        _busy = true;
        _connectorError = "";
        try
        {
            var secrets = new Dictionary<string, string> { ["apiToken"] = _connectorSecret };
            if (_connectorType == "technitium" && !string.IsNullOrWhiteSpace(_connectorEndpoint))
                secrets["endpoint"] = _connectorEndpoint;

            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/connector-instances", new
            {
                name = _connectorName,
                type = _connectorType,
                secrets
            });

            if (!response.IsSuccessStatusCode)
            {
                _connectorError = await response.Content.ReadAsStringAsync();
                return;
            }

            _connectorCreated = true;
            Snackbar.Add(Text["SetupConnectorCreated"], Severity.Success);
        }
        catch (Exception ex) { _connectorError = ex.Message; }
        finally { _busy = false; }
    }

    // ── Step 3: Initialize CA ──────────────────────────────────────────
    private async Task InitializeCaAsync()
    {
        _busy = true;
        try
        {
            using var client = Client();
            var response = await client.PostAsync("api/v1/authorities/initialize", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                if (error.Contains("already configured", StringComparison.OrdinalIgnoreCase))
                {
                    _caCreated = true;
                    Snackbar.Add(Text["SetupAuthoritiesAlreadyConfigured"], Severity.Info);
                }
                else
                {
                    Snackbar.Add(Text["SetupCaCreateFailed", error], Severity.Error);
                }
                return;
            }
            _caCreated = true;
            Snackbar.Add(Text["SetupCaCreatedNotification"], Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task FinishAsync() => await OnSetupComplete.InvokeAsync();

    private async Task SkipWizardAsync()
    {
        _busy = true;
        try
        {
            using var client = Client();
            await client.PostAsync("api/v1/setup/skip", null);
            await OnSkipped.InvokeAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
