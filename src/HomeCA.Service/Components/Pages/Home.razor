)</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@Text["NoRootCaYet"]</MudText></NoRecordsContent></MudTable></MudPaper></MudItem></MudGrid>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["SshCertificateAuthorities"]</MudText><MudText Class="mud-text-secondary mb-3">@Text["SshCertificateAuthoritiesDescription"]</MudText><div class="d-flex gap-2 flex-wrap"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadSshCaKey("host"))">@Text["DownloadSshHostCaKey"]</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadSshCaKey("user"))">@Text["DownloadSshUserCaKey"]</MudButton></div></MudPaper>
    </text>;

    private RenderFragment AutomationContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">@Text["AutomationKicker"]</MudText><MudText Typo="Typo.h3" Class="page-title">@Text["AutomationTitle"]</MudText><MudGrid><MudItem xs="12" md="5"><MudPaper Class="panel" Elevation="0">@RenewalForm</MudPaper></MudItem><MudItem xs="12" md="7"><MudPaper Class="panel" Elevation="0"><MudTable Items="_plans" Dense="true"><HeaderContent><MudTh>@Text["Certificate"]</MudTh><MudTh>@Text["DaysBeforeExpiry"]</MudTh><MudTh>@Text["AcmeColumnStatus"]</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@CertificateName(context.CertificateId)</MudTd><MudTd>@context.RenewBeforeDays</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)">@(context.Enabled ? Text["Active"] : Text["Inactive"])</MudChip></MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginPlanEdit(context))">@Text["Edit"]</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePlan(context.Id))">@(_deletePlanId == context.Id ? Text["ConfirmDelete"] : Text["Delete"])</MudButton></MudTd></RowTemplate></MudTable></MudPaper></MudItem></MudGrid>
        <MudPaper Class="panel mt-4" Elevation="0">@RenewalNotificationForm</MudPaper>
    </text>;

    private RenderFragment SettingsContent => @<text>
        @if (!string.IsNullOrEmpty(_connectorCheckMessage)) { <MudAlert Severity="@(_connectorCheckMessage.StartsWith("Verbindung hergestellt", StringComparison.Ordinal) ? Severity.Success : Severity.Error)" Class="mb-4">@_connectorCheckMessage</MudAlert> }
        <MudText Typo="Typo.overline" Class="section-kicker">@Text["SettingsKicker"]</MudText>
        <MudText Typo="Typo.h3" Class="page-title">@Text["SettingsTitle"]</MudText>
        <MudGrid>
            <MudItem xs="12" lg="6"><MudPaper Class="panel" Elevation="0">@ConnectorForm</MudPaper></MudItem>
            <MudItem xs="12" lg="6"><MudPaper Class="panel" Elevation="0">@DomainForm</MudPaper></MudItem>
        </MudGrid>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["SavedDnsConnectors"]</MudText><MudTable Items="_connectors" Dense="true"><HeaderContent><MudTh>@Text["Name"]</MudTh><MudTh>@Text["Type"]</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Type</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginConnectorEdit(context))">@Text["Edit"]</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => CheckConnector(context.Id))">@(context.Type == Hetzner ? Text["CheckHetzner"] : Text["CheckTechnitium"])</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => TxtTestConnector(context.Id))">@Text["TxtTest"]</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteConnector(context.Id))">@(_deleteConnectorId == context.Id ? Text["ConfirmDelete"] : Text["Delete"])</MudButton></MudTd></RowTemplate></MudTable></MudPaper>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["SavedDomains"]</MudText><MudTable Items="_domains" Dense="true"><HeaderContent><MudTh>@Text["DomainName"]</MudTh><MudTh>@Text["IssuanceZone"]</MudTh><MudTh>@Text["DnsConnector"]</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@(context.InternalIssuanceEnabled ? Text["Internal"] : Text["External"])</MudTd><MudTd>@ConnectorName(context.ConnectorId)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginDomainEdit(context))">@Text["Edit"]</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteDomain(context.Name))">@(_deleteDomainName == context.Name ? Text["ConfirmDelete"] : Text["Delete"])</MudButton></MudTd></RowTemplate></MudTable></MudPaper>
        <MudPaper Class="panel mt-4" Elevation="0">
            <MudText Typo="Typo.h5">@Text["TlsSettingsTitle"]</MudText>
            <MudText Class="mud-text-secondary mb-3">
                @Text["TlsSettingsDescription"]
            </MudText>
            @if (!string.IsNullOrEmpty(_tlsSettingsSuccess))
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@_tlsSettingsSuccess</MudAlert>
                @if (_tlsActivated)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        @Text["TlsRestartNotice"]
                    </MudAlert>
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mb-3" />
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_tlsActivateError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_tlsActivateError</MudAlert>
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            @Text["TlsHostAlternative"]
                        </MudAlert>
                        <CodePreview Text="@_tlsRestartCommand" Lines="2" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mt-3"
                        Disabled="_busy" OnClick="ApplyTlsAndRestartAsync"
                        StartIcon="@Icons.Material.Filled.RestartAlt">
                        @(_busy ? Text["TlsActivating"] : Text["TlsActivateRestart"])
                    </MudButton>
                }
            }
            else
            {
                <MudForm @ref="_tlsSettingsForm" @bind-IsValid="_tlsSettingsValid">
                    <MudTextField @bind-Value="_tlsHostname" Label="@Text["SetupHostnameLabel"]" Placeholder="homeca.home.local"
                        Required="true" RequiredError="@Text["SetupHostnameRequired"]" Immediate="true"
                        HelperText="@Text["TlsHostnameHelper"]" />
                    <MudTextField @bind-Value="_tlsIpAddress" Label="@Text["TlsIpAddress"]" Placeholder="10.5.0.131"
                        Immediate="true" HelperText="@Text["TlsIpAddressHelper"]" Class="mt-2" />
                </MudForm>
                @if (!string.IsNullOrEmpty(_tlsSettingsError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_tlsSettingsError</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                    Disabled="@(!_tlsSettingsValid || _busy)" OnClick="ActivateTlsAsync">
                    @(_busy ? Text["TlsSettingUp"] : Text["TlsIssueActivate"])
                </MudButton>
            }
        </MudPaper>
        <MudPaper Class="panel mt-4" Elevation="0"><MudText Typo="Typo.h5">@Text["SetupRepeatTitle"]</MudText><MudText Class="mud-text-secondary mb-3">@Text["SetupRepeatDescription"]</MudText><MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy" OnClick="ResetSetupWizardAsync" StartIcon="@Icons.Material.Filled.RestartAlt">@Text["SetupRepeat"]</MudButton></MudPaper>
    </text>;

    private RenderFragment ProfilesContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">@Text["ProfilesKicker"]</MudText><MudText Typo="Typo.h3" Class="page-title">@Text["ProfilesTitle"]</MudText>
        <MudGrid><MudItem xs="12" lg="4"><MudPaper Class="panel" Elevation="0">@ProfileForm</MudPaper></MudItem><MudItem xs="12" lg="8"><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["TargetProfiles"]</MudText><MudTable Items="_profiles" Dense="true" Hover="true"><HeaderContent><MudTh>@Text["Name"]</MudTh><MudTh>ID</MudTh><MudTh>@Text["Version"]</MudTh><MudTh>@Text["ColumnAlgorithm"]</MudTh><MudTh>@Text["ExportFormats"]</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@ProfileDisplayName(context)</MudTd><MudTd>@context.Id</MudTd><MudTd>@context.Version</MudTd><MudTd>@ProfileKeyAlgorithm(context)</MudTd><MudTd>@string.Join(", ", ProfileExportFormats(context))</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginProfileEdit(context))">@Text["Edit"]</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteProfile(context.Id))">@(_deleteProfileId == context.Id ? Text["ConfirmDelete"] : Text["Delete"])</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@Text["NoTargetProfiles"]</MudText></NoRecordsContent></MudTable></MudPaper></MudItem></MudGrid>
    </text>;

    private RenderFragment OperationsContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">@Text["OperationsKicker"]</MudText><MudText Typo="Typo.h3" Class="page-title">@Text["OperationsTitle"]</MudText><MudGrid><MudItem xs="12" lg="5"><MudPaper Class="panel" Elevation="0">@RevocationForm<MudDivider Class="my-4" /><MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="_busy" OnClick="GenerateCrl">@Text["GenerateCrl"]</MudButton></MudPaper></MudItem><MudItem xs="12" lg="7"><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h6">@Text["Revocations"]</MudText><MudTable Items="_revocations" Dense="true"><HeaderContent><MudTh>@Text["SerialNumber"]</MudTh><MudTh>@Text["Reason"]</MudTh><MudTh>@Text["Date"]</MudTh></HeaderContent><RowTemplate><MudTd>@context.SerialNumber</MudTd><MudTd>@context.Reason</MudTd><MudTd>@Date(context.RevokedAt)</MudTd></RowTemplate></MudTable></MudPaper></MudItem></MudGrid>
