    private void ApplyProfileDefaults()
    {
        var profile = SelectedProfile;
        if (profile is null) return;

        _keyAlgorithm = ProfileKeyAlgorithm(profile);
        _validityDays = Math.Min(Math.Max(_validityDays, 1), Math.Max(1, ProfileMaximumValidityDays(profile)));

        if (!ProfileAllowsIpAddress(profile))
        {
            _ipAddresses = "";
        }

        if (string.Equals(ProfileKeyAlgorithm(profile), Rsa, StringComparison.OrdinalIgnoreCase) && _rsaKeySize < 2048)
        {
            _rsaKeySize = 2048;
        }
    }
