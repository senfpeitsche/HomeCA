@page "/"
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IHostEnvironment Host
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text
@inject HomeCaInternalHttpClient InternalHttpClient
@inject HomeCA.Service.Security.BrowserSessionService BrowserSessions
@inject HomeCA.Service.Security.LocalAdministrationService Administration

<PageTitle>HomeCA</PageTitle>

@if (string.IsNullOrEmpty(_token))
{
    <main class="login-shell">
        <AppearanceControls />
        <MudPaper Class="login-card" Elevation="0">
            <MudText Typo="Typo.overline" Class="signal-text">@Text["LoginSignalText"]</MudText>
            <MudText Typo="Typo.h2" Class="service-title">
                <img src="@WideLogo" width="720" height="229" alt="HomeCA" class="service-logo" />
            </MudText>
            <MudText Class="mud-text-secondary">@Text["LoginSubtitle"]</MudText>
            @if (_isFirstLogin)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@Text["DefaultCredentialsHint"]</MudAlert>
            }
            <MudForm @ref="_loginForm" Class="form-stack" @bind-IsValid="_loginValid">
                <MudTextField @bind-Value="_loginUser" Label="@Text["LoginUsername"]" Required="true" Immediate="true" />
                <MudTextField @bind-Value="_loginPassword" Label="@Text["LoginPassword"]" InputType="InputType.Password" Required="true" Immediate="true" />
                @if (!string.IsNullOrEmpty(_loginError)) { <MudAlert Severity="Severity.Error" Dense="true">@_loginError</MudAlert> }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" Disabled="_busy" OnClick="LoginAsync" FullWidth="true">@(_busy ? Text["LoginBusy"] : Text["LoginButton"])</MudButton>
            </MudForm>
        </MudPaper>
        <MudPaper Class="login-card mt-4" Elevation="0">
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                <MudExpansionPanel Text="@Text["TrustInstallTitle"]">
                    <MudText Class="mud-text-secondary mb-2">@Text["TrustInstallDescription"]</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">@Text["TrustCertificateChain"]</MudText>
                    <MudSimpleTable Dense="true" Bordered="true" Class="trust-anchor-table">
                        <thead><tr><th>@Text["Certificate"]</th><th>@Text["Usage"]</th><th>@Text["Download"]</th></tr></thead>
                        <tbody>
                            <tr><td><strong>@Text["RootCa"]</strong></td><td>@Text["TrustRootCaUsage"]</td><td><MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"{BaseUrl}/api/v1/trust-anchor/pem")" Target="_blank">PEM</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"{BaseUrl}/api/v1/trust-anchor/der")" Target="_blank">@Text["WindowsCer"]</MudButton></td></tr>
                            <tr><td><strong>@Text["IntermediateCa"]</strong></td><td>@Text["TrustIntermediateCaUsage"]</td><td><MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"{BaseUrl}/api/v1/trust-anchor/intermediate/pem")" Target="_blank">PEM</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" Href="@($"{BaseUrl}/api/v1/trust-anchor/intermediate/der")" Target="_blank">@Text["WindowsCer"]</MudButton></td></tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Text["TrustRootCaNotice"]</MudAlert>

                    <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2">@Text["TrustInstallationGuides"]</MudText>
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="trust-install-guides">
                        <MudExpansionPanel Text="@Text["TrustWindowsPowerShell"]"><div class="script-preview script-preview-static"><pre><code>@TrustScriptWindows</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyWindowsScript"]" OnClick="@(() => CopyToClipboard(TrustScriptWindows))" /></div></MudExpansionPanel>
                        <MudExpansionPanel Text="@Text["TrustWindowsActiveDirectoryTitle"]"><MudText Class="mud-text-secondary">@Text["TrustWindowsActiveDirectoryDescription"]</MudText></MudExpansionPanel>
                        <MudExpansionPanel Text="Debian / Ubuntu"><div class="script-preview script-preview-static"><pre><code>@TrustScriptLinux</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyLinuxScript"]" OnClick="@(() => CopyToClipboard(TrustScriptLinux))" /></div></MudExpansionPanel>
                        <MudExpansionPanel Text="Proxmox VE"><div class="script-preview script-preview-static"><pre><code>@TrustScriptProxmox</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyProxmoxScript"]" OnClick="@(() => CopyToClipboard(TrustScriptProxmox))" /></div></MudExpansionPanel>
                        <MudExpansionPanel Text="OPNsense"><MudText Class="mud-text-secondary">@Text["TrustOpnSenseDescription"]</MudText></MudExpansionPanel>
                        <MudExpansionPanel Text="@Text["TrustHaProxyTitle"]"><MudText Class="mud-text-secondary mb-2">@Text["TrustHaProxyDescription"]</MudText><div class="script-preview script-preview-static"><pre><code>@TrustScriptHaProxy</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyHaProxyGuide"]" OnClick="@(() => CopyToClipboard(TrustScriptHaProxy))" /></div></MudExpansionPanel>
                        <MudExpansionPanel Text="VMware vCenter / ESXi"><MudText Class="mud-text-secondary">@Text["TrustVmwareDescription"]</MudText></MudExpansionPanel>
                        <MudExpansionPanel Text="macOS"><div class="script-preview script-preview-static"><pre><code>@TrustScriptMacOs</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyMacOsScript"]" OnClick="@(() => CopyToClipboard(TrustScriptMacOs))" /></div></MudExpansionPanel>
                        <MudExpansionPanel Text="@Text["TrustFirefoxTitle"]"><div class="script-preview script-preview-static"><pre><code>@TrustScriptFirefox</code></pre><MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@Text["TrustCopyFirefoxPolicy"]" OnClick="@(() => CopyToClipboard(TrustScriptFirefox))" /></div></MudExpansionPanel>
                    </MudExpansionPanels>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
    </main>
}
else if (_mustChangePassword)
{
    <main class="login-shell">
        <AppearanceControls />
        <MudPaper Class="login-card" Elevation="0">
            <MudText Typo="Typo.overline" Class="signal-text">@Text["LoginSignalText"]</MudText>
            <MudText Typo="Typo.h2" Class="service-title">
                <img src="@WideLogo" width="720" height="229" alt="HomeCA" class="service-logo" />
            </MudText>
            <MudText Class="mud-text-secondary">@Text["ChangePasswordDescription"]</MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@Text["DefaultCredentialsHint"]</MudAlert>
            <MudForm @ref="_changePasswordForm" Class="form-stack" @bind-IsValid="_changePasswordValid">
                <MudTextField @bind-Value="_currentPassword" Label="@Text["CurrentPassword"]" InputType="InputType.Password" Required="true" Immediate="true" />
                <MudTextField @bind-Value="_newPassword" Label="@Text["NewPassword"]" InputType="InputType.Password" Required="true" Immediate="true" Validation="@(new Func<string, string?>(ValidateNewPassword))" />
                <MudTextField @bind-Value="_confirmPassword" Label="@Text["ConfirmNewPassword"]" InputType="InputType.Password" Required="true" Immediate="true" Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />
                @if (!string.IsNullOrEmpty(_changePasswordError)) { <MudAlert Severity="Severity.Error" Dense="true">@_changePasswordError</MudAlert> }
                @if (!string.IsNullOrEmpty(_changePasswordSuccess)) { <MudAlert Severity="Severity.Success" Dense="true">@_changePasswordSuccess</MudAlert> }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" Disabled="_busy" OnClick="ChangePasswordAsync" FullWidth="true">@(_busy ? Text["ChangePasswordBusy"] : Text["ChangePasswordButton"])</MudButton>
            </MudForm>
        </MudPaper>
    </main>
}
else if (_showSetupWizard)
{
    <SetupWizard Token="@_token" InitialPhase="@_setupPhase" OnSetupComplete="OnWizardComplete" OnSkipped="OnWizardSkipped" />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0" Class="app-bar">
            <img src="@BarLogo" width="323" height="96" alt="HomeCA" class="app-logo" />
            <MudText Typo="Typo.h5" Class="app-name"><span>@Text["AppNameSuffix"]</span></MudText>
            <MudSpacer />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Wrap="Wrap.NoWrap" Class="app-bar-actions">
                @if (_updateAvailable && !string.IsNullOrEmpty(_latestVersion))
                {
                    <MudTooltip Text="@Text["UpdateAvailable", _latestVersion]">
                        <MudBadge Content="1" Color="Color.Warning" Overlap="true" Bordered="true">
                            <MudIconButton Icon="@Icons.Material.Filled.SystemUpdate" Color="Color.Warning" aria-label="@Text["UpdateAvailableAria"]" OnClick="OpenUpdateRelease" />
                        </MudBadge>
                    </MudTooltip>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@Text["RefreshAriaLabel"]" OnClick="LoadAllAsync" Disabled="_busy" />
                <AppearanceControls />
                <MudTooltip Text="@(_confirmLogout ? Text["ConfirmSignOut"] : Text["LogoutButton"])">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="@(_confirmLogout ? Color.Warning : Color.Inherit)"
                                   aria-label="@(_confirmLogout ? Text["ConfirmSignOut"] : Text["LogoutButton"])"
                                   OnClick="Logout" />
                </MudTooltip>
            </MudStack>
        </MudAppBar>
        <MudDrawer Open="true" Variant="DrawerVariant.Responsive" Elevation="0" Class="nav-rail">
            <MudNavMenu>
                @foreach (var entry in Nav)
                {
                    <MudNavLink Class="@NavClass(entry.Key)" OnClick="@(() => Navigate(entry.Key))">@entry.Value</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent Class="workspace">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="page-loader" />
            }
            @if (!string.IsNullOrEmpty(_pageError)) { <MudAlert Severity="Severity.Error" Class="mb-4">@_pageError</MudAlert> }
            @if (_section == "overview") { @OverviewContent }
            else if (_section == "certificates") { @CertificatesContent }
            else if (_section == "authorities") { @AuthoritiesContent }
            else if (_section == "automation") { @AutomationContent }
            else if (_section == "settings") { @SettingsContent }
            else if (_section == "profiles") { @ProfilesContent }
            else if (_section == "operations") { @OperationsContent }
            else if (_section == "acme") { @AcmeContent }
            else if (_section == "help") { <HelpContent /> }

            @* ── Global dialogs (visible from any section) ── *@
            <MudDialog @bind-Visible="_pfxDialogVisible"><TitleContent><MudText Typo="Typo.h6">@Text["PfxDialogTitle"]</MudText></TitleContent><DialogContent><MudText Class="mb-3">@Text["PfxDialogDescription"]</MudText><MudTextField @bind-Value="_pfxPassword" Label="@Text["PfxPasswordLabel"]" InputType="InputType.Password" Required="true" Immediate="true" /><MudTextField Value="_pfxPassword" Label="@Text["PfxConfirmLabel"]" InputType="InputType.Password" ReadOnly="true" Disabled="true" Class="mt-2" /></DialogContent><DialogActions><MudButton OnClick="CancelPfxDialog">@Text["Cancel"]</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_pfxPassword) || _busy)" OnClick="DownloadPfx">@Text["Download"]</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_detailsDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">@Text["CertificateDetailsTitle"]</MudText></TitleContent><DialogContent>@if (_certificateDetails is { } d) {
                <MudSimpleTable Dense="true" Bordered="true" Class="details-table"><tbody>
                    <tr><td><strong>@Text["Subject"]</strong></td><td>@d.Subject</td></tr>
                    <tr><td><strong>@Text["Issuer"]</strong></td><td>@d.Issuer</td></tr>
                    <tr><td><strong>@Text["SerialNumber"]</strong></td><td style="font-family:monospace">@d.SerialNumber</td></tr>
                    <tr><td><strong>@Text["Fingerprint"]</strong></td><td style="font-family:monospace;word-break:break-all">@d.Sha256Fingerprint</td></tr>
                    <tr><td><strong>@Text["ValidFrom"]</strong></td><td>@Date(d.ValidFrom)</td></tr>
                    <tr><td><strong>@Text["ValidUntil"]</strong></td><td>@Date(d.ExpiresAt)</td></tr>
                    <tr><td><strong>@Text["Algorithm"]</strong></td><td>@d.KeyAlgorithm (@(d.KeySize) Bit)</td></tr>
                    <tr><td><strong>@Text["Usage"]</strong></td><td>@d.Usage</td></tr>
                    <tr><td><strong>@Text["DnsNames"]</strong></td><td>@(d.DnsNames.Count > 0 ? string.Join(", ", d.DnsNames) : "—")</td></tr>
                    <tr><td><strong>@Text["IpAddresses"]</strong></td><td>@(d.IpAddresses.Count > 0 ? string.Join(", ", d.IpAddresses) : "—")</td></tr>
                    <tr><td><strong>@Text["ExtendedKeyUsage"]</strong></td><td>@(d.EnhancedKeyUsages.Count > 0 ? string.Join(", ", d.EnhancedKeyUsages) : "—")</td></tr>
                    <tr><td><strong>@Text["CertificateId"]</strong></td><td style="font-family:monospace">@d.Id</td></tr>
                </tbody></MudSimpleTable>
            }</DialogContent><DialogActions><MudButton OnClick="CloseDetailsDialog">@Text["Close"]</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_rfc8555OrderDetailsDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">@Text["Rfc8555OrderDetails"]</MudText></TitleContent><DialogContent>@if (_rfc8555OrderDetails is { } d) {
                <MudSimpleTable Dense="true" Bordered="true" Class="details-table"><tbody>
                    <tr><td><strong>@Text["OrderId"]</strong></td><td style="font-family:monospace;word-break:break-all">@d.Id</td></tr>
                    <tr><td><strong>@Text["AccountId"]</strong></td><td style="font-family:monospace;word-break:break-all">@d.AccountId</td></tr>
                    <tr><td><strong>@Text["Status"]</strong></td><td><MudChip T="string" Size="Size.Small" Color="@Rfc8555StatusColor(d.Status)">@d.Status</MudChip></td></tr>
                    <tr><td><strong>@Text["Created"]</strong></td><td>@Date(d.CreatedAt)</td></tr>
                    <tr><td><strong>@Text["Expires"]</strong></td><td>@Date(d.Expires)</td></tr>
                    <tr><td><strong>@Text["Identifiers"]</strong></td><td>@string.Join(", ", d.Identifiers.Select(identifier => $"{identifier.Type}: {identifier.Value}"))</td></tr>
                    <tr><td><strong>@Text["CertificateId"]</strong></td><td style="font-family:monospace;word-break:break-all">@(d.CertificateId ?? "—")</td></tr>
                </tbody></MudSimpleTable>
                @if (!string.IsNullOrWhiteSpace(d.Error)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3"><strong>@Text["AcmeError"]</strong> @d.Error</MudAlert> }
                <MudText Typo="Typo.h6" Class="mt-5 mb-2">@Text["Authorizations"]</MudText>
                @if (d.Authorizations.Count == 0) { <MudText Class="mud-text-secondary">@Text["NoAuthorizations"]</MudText> }
                else { <MudExpansionPanels MultiExpansion="true" Elevation="0">@foreach (var authorization in d.Authorizations) { <MudExpansionPanel Text="@($"{authorization.Identifier.Value} · {authorization.Status}")"><MudSimpleTable Dense="true" Bordered="true"><tbody><tr><td><strong>@Text["AuthorizationId"]</strong></td><td style="font-family:monospace;word-break:break-all">@authorization.Id</td></tr><tr><td><strong>@Text["Status"]</strong></td><td><MudChip T="string" Size="Size.Small" Color="@Rfc8555StatusColor(authorization.Status)">@authorization.Status</MudChip></td></tr><tr><td><strong>@Text["Expires"]</strong></td><td>@Date(authorization.Expires)</td></tr></tbody></MudSimpleTable><MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["Challenges"]</MudText><MudTable Items="authorization.Challenges" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@Text["Type"]</MudTh><MudTh>@Text["Status"]</MudTh><MudTh>@Text["Validated"]</MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(12, context.Id.Length)]…</MudText></MudTd><MudTd>@context.Type</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@Rfc8555StatusColor(context.Status)">@context.Status</MudChip></MudTd><MudTd>@(context.ValidatedAt is { } validatedAt ? Date(validatedAt) : "—")</MudTd></RowTemplate></MudTable></MudExpansionPanel> }</MudExpansionPanels> }
            }</DialogContent><DialogActions><MudButton OnClick="CloseRfc8555OrderDetails">@Text["Close"]</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_rfc8555AccountDetailsDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">@Text["Rfc8555AccountDetails"]</MudText></TitleContent><DialogContent>@if (_rfc8555AccountDetails is { } d) {
                <MudSimpleTable Dense="true" Bordered="true" Class="details-table"><tbody>
                    <tr><td><strong>@Text["AccountId"]</strong></td><td style="font-family:monospace;word-break:break-all">@d.Id</td></tr>
                    <tr><td><strong>@Text["JwkThumbprint"]</strong></td><td style="font-family:monospace;word-break:break-all">@d.Thumbprint</td></tr>
                    <tr><td><strong>@Text["Contact"]</strong></td><td>@(d.Contact.Length > 0 ? string.Join(", ", d.Contact) : "—")</td></tr>
                    <tr><td><strong>@Text["Status"]</strong></td><td><MudChip T="string" Size="Size.Small" Color="@Rfc8555StatusColor(d.Status)">@d.Status</MudChip></td></tr>
                    <tr><td><strong>@Text["Created"]</strong></td><td>@Date(d.CreatedAt)</td></tr>
                    <tr><td><strong>@Text["Orders"]</strong></td><td>@d.Orders.Count</td></tr>
                </tbody></MudSimpleTable>
                <MudText Typo="Typo.h6" Class="mt-5 mb-2">@Text["AssociatedOrders"]</MudText>
                <MudTable Items="d.Orders" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@Text["Status"]</MudTh><MudTh>@Text["Created"]</MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(12, context.Id.Length)]…</MudText></MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@Rfc8555StatusColor(context.Status)">@context.Status</MudChip></MudTd><MudTd>@Date(context.CreatedAt)</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@Text["NoAssociatedOrders"]</MudText></NoRecordsContent></MudTable>
            }</DialogContent><DialogActions><MudButton OnClick="CloseRfc8555AccountDetails">@Text["Close"]</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_sshCertDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">@Text["SshCertificateDialogTitle", _sshCertDialogIdentity ?? string.Empty]</MudText></TitleContent><DialogContent><MudText Class="mb-3">@Text["SshCertificateDialogDescription"]</MudText><CodePreview Text="@(_sshCertDialogContent ?? string.Empty)" Lines="4" />
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-2">@(_sshCertDialogKind == "host" ? Text["DeployHostCertificate"] : Text["UseUserCertificate"])</MudText>
            @if (_sshCertDialogKind == "host") {
                <MudText Class="mud-text-secondary mb-2">@Text["SshHostCertificateDescription"]</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshWriteCertificate"]</MudText>
                <CodePreview Text="@SshHostDeployScript" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshConfigureSshd"]</MudText>
                <CodePreview Text="@SshHostSshdConfigScript" Lines="2" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshReloadDaemon"]</MudText>
                <CodePreview Text="@SshReloadSshdScript" Lines="2" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Text["SshHostTrustNotice"]</MudAlert>
            } else {
                <MudText Class="mud-text-secondary mb-2">@Text["SshUserCertificateDescription"]</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshSaveCertificate"]</MudText>
                <CodePreview Text="@SshUserDeployScript" Lines="2" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshTestConnection"]</MudText>
                <CodePreview Text="@SshUserTestScript" Lines="2" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Text["SshUserTrustNotice"]</MudAlert>
            }
            <MudDivider Class="my-4" />
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                <MudExpansionPanel Text="@Text["ConfigureTrust"]">
                    @if (_sshCertDialogKind == "host") {
                        <MudText Class="mud-text-secondary mb-2">@Text["SshHostTrustDescription"]</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@Text["SshSingleUser"]</MudText>
                        <CodePreview Text="@SshHostTrustUserScript" Lines="2" />
                        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">@Text["SshSystemWide"]</MudText>
                        <CodePreview Text="@SshHostTrustSystemScript" Lines="2" />
                    } else {
                        <MudText Class="mud-text-secondary mb-2">@Text["SshUserTrustDescription"]</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">@Text["SshConfigureUserCaTrust"]</MudText>
                        <CodePreview Text="@SshUserTrustScript" Lines="5" />
                    }
                </MudExpansionPanel>
                <MudExpansionPanel Text="@Text["VerifyCertificate"]">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@Text["ShowCertificateContent"]</MudText>
                    <CodePreview Text="@SshVerifyScript" Lines="2" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            </DialogContent><DialogActions><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="DownloadSshCertificateFile">@Text["Download"]</MudButton><MudButton OnClick="CloseSshCertDialog">@Text["Close"]</MudButton></DialogActions></MudDialog>

        </MudMainContent>
    </MudLayout>
}

@code {
    // The navy wordmark is only 1.8:1 on the dark surface, hence two renderings.
    [CascadingParameter(Name = "IsDarkMode")] private bool IsDarkMode { get; set; }
    private string WideLogo => IsDarkMode ? "brand/logo-wide-dark.png" : "brand/logo-wide.png";
    private string BarLogo => IsDarkMode ? "brand/logo-dark.png" : "brand/logo.png";

    private (string Key, string Value)[] Nav => [("overview", Text["NavOverview"]), ("certificates", Text["NavCertificates"]), ("authorities", Text["NavAuthorities"]), ("acme", Text["NavAcme"]), ("automation", Text["NavAutomation"]), ("settings", Text["NavSettings"]), ("profiles", Text["NavProfiles"]), ("operations", Text["NavOperations"]), ("help", Text["NavHelp"])];
    private const string Tls = "TLS", ClientUsage = "mTLS", Ecc = "ECC", Rsa = "RSA", RootAuthority = "root", IntermediateAuthority = "intermediate", HostKind = "host", UserKind = "user", Hetzner = "hetzner", Technitium = "technitium", Unspecified = "unspecified", KeyCompromise = "keyCompromise", CessationOfOperation = "cessationOfOperation", smtp = "smtp", m365 = "m365";
    private readonly JsonSerializerOptions _json = new(JsonSerializerDefaults.Web);
    private string? _token, _loginUser, _loginPassword, _loginError, _pageError, _connectorCheckMessage, _editingConnectorId, _editingDomainName, _editingAuthorityId, _editingProfileId, _deleteAuthorityId, _deleteProfileId, _deleteCertificateId;
    private string _section = "overview";
    private void Navigate(string section) { _section = section; _confirmLogout = false; }
    private bool _busy, _loading, _loginValid, _mustChangePassword, _showSetupWizard, _confirmLogout;
    private string _setupPhase = "initial";
    private bool _isFirstLogin = true;
    private List<DnsCheckResult> _dnsCheckResults = [];
    private MudForm? _loginForm, _changePasswordForm;
    private string _currentPassword = "", _newPassword = "", _confirmPassword = "";
    private string? _changePasswordError, _changePasswordSuccess;
    private bool _changePasswordValid;
    private List<Certificate> _certificates = [];
    private List<Authority> _authorities = [];
    private List<Domain> _domains = [];
    private List<Connector> _connectors = [];
