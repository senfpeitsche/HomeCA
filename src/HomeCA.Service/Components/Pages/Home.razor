    private static readonly System.Text.RegularExpressions.Regex DnsNamePattern = new(
        @"^(\*\.)?([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z]{2,}$",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private string? ValidateDnsNames(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null; // Required is handled separately
        foreach (var name in Split(value))
        {
            if (name.Length > 253) return Text["DnsNameTooLong", name];
            if (name.Contains(' ')) return Text["DnsNameContainsSpaces", name];
            if (name.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || name.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
                return Text["DnsNameLooksLikeUrl", name];
            if (!DnsNamePattern.IsMatch(name))
                return Text["DnsNameInvalid", name];
        }
        return null;
    }

    private record DnsCheckResult(Severity Severity, string Message);

    private async Task CheckDnsNamesAsync()
    {
        _dnsCheckResults = [];
        if (string.IsNullOrWhiteSpace(_dnsNames)) return;

        _busy = true;
        try
        {
            foreach (var name in Split(_dnsNames))
            {
                if (name.StartsWith("*."))
                {
                    _dnsCheckResults.Add(new DnsCheckResult(Severity.Info, Text["DnsWildcardNotCheckable", name]));
                    continue;
                }

                try
                {
                    var addresses = await System.Net.Dns.GetHostAddressesAsync(name);
                    if (addresses.Length > 0)
                    {
                        var ips = string.Join(", ", addresses.Select(a => a.ToString()));
                        _dnsCheckResults.Add(new DnsCheckResult(Severity.Success, $"{name} → {ips}"));
                    }
                    else
                    {
                        _dnsCheckResults.Add(new DnsCheckResult(Severity.Warning, Text["DnsNoAddressFound", name]));
                    }
                }
                catch
                {
                    _dnsCheckResults.Add(new DnsCheckResult(Severity.Warning, Text["DnsResolutionFailed", name]));
                }
            }
        }
        finally { _busy = false; }
    }

    // ── Setup wizard integration ────────────────────────────────────────────
    private record SetupStateDto(string Phase, bool IsComplete);
    private record SetupPhaseDto(string Phase);
    private async Task CheckSetupStateAsync()
    {
        try
        {
            using var client = Client();
            var state = await client.GetFromJsonAsync<SetupStateDto>("api/v1/setup/state", _json);
            if (state is not null && !state.IsComplete)
            {
                _showSetupWizard = true;
                _setupPhase = state.Phase;
            }
            else
            {
                _showSetupWizard = false;
            }
        }
        catch
        {
            _showSetupWizard = false;
        }
    }
    private async Task OnWizardComplete()
    {
        _showSetupWizard = false;
        await LoadAllAsync();
    }
    private async Task OnWizardSkipped()
    {
        _showSetupWizard = false;
        await LoadAllAsync();
    }

    private async Task ResetSetupWizardAsync()
    {
        _busy = true;
        try
        {
            using var client = Client();
            var response = await client.PostAsync("api/v1/setup/reset", null);
            if (!response.IsSuccessStatusCode) { Snackbar.Add(Text["ResetFailed"], Severity.Error); return; }
            _showSetupWizard = true;
            _setupPhase = "passwordchanged";
            Snackbar.Add(Text["SetupWizardStarted"], Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    // ── TLS settings ────────────────────────────────────────────────────────
    private string _tlsHostname = "", _tlsIpAddress = "";
    private string? _tlsSettingsError, _tlsSettingsSuccess, _tlsRestartCommand, _tlsActivateError;
    private bool _tlsSettingsValid, _tlsActivated;
    private MudForm? _tlsSettingsForm;

    private async Task ActivateTlsAsync()
    {
        if (_tlsSettingsForm is not null) { await _tlsSettingsForm.Validate(); if (!_tlsSettingsValid) return; }
        if (string.IsNullOrWhiteSpace(_tlsHostname)) { _tlsSettingsError = "Hostname ist erforderlich."; return; }

        _busy = true;
        _tlsSettingsError = null;
        _tlsSettingsSuccess = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/setup/activate-tls", new
            {
                hostname = _tlsHostname,
                ipAddress = string.IsNullOrWhiteSpace(_tlsIpAddress) ? null : _tlsIpAddress
            });
            if (!response.IsSuccessStatusCode)
            {
                _tlsSettingsError = await response.Content.ReadAsStringAsync();
                return;
            }
            _tlsSettingsSuccess = $"TLS-Zertifikat für {_tlsHostname} ausgestellt. Nach dem Neustart ist HomeCA unter https://{_tlsHostname}:5443 erreichbar.";
            _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
            Snackbar.Add(Text["TlsCertificateIssued"], Severity.Success);
        }
        catch (Exception ex) { _tlsSettingsError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ApplyTlsAndRestartAsync()
    {
        _busy = true;
        _tlsActivateError = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsync("api/v1/system/activate-tls", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _tlsActivateError = $"Aktivierung fehlgeschlagen: {body}";
                _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
                return;
            }
            _tlsActivated = true;
            Snackbar.Add(Text["TlsActivatingRestart"], Severity.Success);
            using var activation = await response.Content.ReadFromJsonAsync<JsonDocument>(_json);
            var publicUrl = activation?.RootElement.TryGetProperty("publicUrl", out var configuredUrl) == true ? configuredUrl.GetString() : null;
            if (string.IsNullOrWhiteSpace(publicUrl) || !Uri.TryCreate(publicUrl, UriKind.Absolute, out var target) || target.Scheme != Uri.UriSchemeHttps)
            {
                _tlsActivateError = "TLS wurde aktiviert, aber die HTTPS-Zieladresse konnte nicht gelesen werden.";
                return;
            }

            // Schedule in the browser before the server restarts; the Blazor circuit is disconnected during that restart.
            await JS.InvokeVoidAsync("homeca.redirectAfter", target.AbsoluteUri, 6000);
        }
        catch (Exception ex)
        {
            _tlsActivateError = ex.Message;
            _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
        }
        finally { _busy = false; }
    }

