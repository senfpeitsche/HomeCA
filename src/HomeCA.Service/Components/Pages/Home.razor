@page "/"
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IHostEnvironment Host
@inject IJSRuntime JS
@inject UiStrings L

<PageTitle>HomeCA</PageTitle>

@if (string.IsNullOrEmpty(_token))
{
    <main class="login-shell">
        <MudPaper Class="login-card" Elevation="0">
            <MudText Typo="Typo.overline" Class="signal-text">@L.LoginSignalText</MudText>
            <MudText Typo="Typo.h2" Class="service-title">HomeCA</MudText>
            <MudText Class="mud-text-secondary">@L.LoginSubtitle</MudText>
            @if (_isFirstLogin)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L.DefaultCredentialsHint</MudAlert>
            }
            <MudForm @ref="_loginForm" Class="form-stack" @bind-IsValid="_loginValid">
                <MudTextField @bind-Value="_loginUser" Label="@L.LoginUsername" Required="true" Immediate="true" />
                <MudTextField @bind-Value="_loginPassword" Label="@L.LoginPassword" InputType="InputType.Password" Required="true" Immediate="true" />
                @if (!string.IsNullOrEmpty(_loginError)) { <MudAlert Severity="Severity.Error" Dense="true">@_loginError</MudAlert> }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" Disabled="_busy" OnClick="LoginAsync" FullWidth="true">@(_busy ? L.LoginBusy : L.LoginButton)</MudButton>
            </MudForm>
        </MudPaper>
        <MudPaper Class="login-card mt-4" Elevation="0">
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                <MudExpansionPanel Text="@L.TrustInstallTitle">
                    <MudText Class="mud-text-secondary mb-2">@L.TrustInstallDescription</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Windows (PowerShell als Administrator)</MudText>
                    <div class="script-preview script-preview-static">
                        <pre><code>@TrustScriptWindows</code></pre>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="Windows-Skript kopieren" OnClick="@(() => CopyToClipboard(TrustScriptWindows))" />
                    </div>
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Linux (Debian/Ubuntu)</MudText>
                    <div class="script-preview script-preview-static">
                        <pre><code>@TrustScriptLinux</code></pre>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="Linux-Skript kopieren" OnClick="@(() => CopyToClipboard(TrustScriptLinux))" />
                    </div>
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">macOS</MudText>
                    <div class="script-preview script-preview-static">
                        <pre><code>@TrustScriptMacOs</code></pre>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="macOS-Skript kopieren" OnClick="@(() => CopyToClipboard(TrustScriptMacOs))" />
                    </div>
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Firefox (Enterprise-Richtlinie)</MudText>
                    <div class="script-preview script-preview-static">
                        <pre><code>@TrustScriptFirefox</code></pre>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="Firefox-Skript kopieren" OnClick="@(() => CopyToClipboard(TrustScriptFirefox))" />
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
    </main>
}
else if (_mustChangePassword)
{
    <main class="login-shell">
        <MudPaper Class="login-card" Elevation="0">
            <MudText Typo="Typo.overline" Class="signal-text">@L.LoginSignalText</MudText>
            <MudText Typo="Typo.h2" Class="service-title">HomeCA</MudText>
            <MudText Class="mud-text-secondary">@L.ChangePasswordDescription</MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@L.DefaultCredentialsHint</MudAlert>
            <MudForm @ref="_changePasswordForm" Class="form-stack" @bind-IsValid="_changePasswordValid">
                <MudTextField @bind-Value="_currentPassword" Label="@L.CurrentPassword" InputType="InputType.Password" Required="true" Immediate="true" />
                <MudTextField @bind-Value="_newPassword" Label="@L.NewPassword" InputType="InputType.Password" Required="true" Immediate="true" Validation="@(new Func<string, string?>(ValidateNewPassword))" />
                <MudTextField @bind-Value="_confirmPassword" Label="@L.ConfirmNewPassword" InputType="InputType.Password" Required="true" Immediate="true" Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />
                @if (!string.IsNullOrEmpty(_changePasswordError)) { <MudAlert Severity="Severity.Error" Dense="true">@_changePasswordError</MudAlert> }
                @if (!string.IsNullOrEmpty(_changePasswordSuccess)) { <MudAlert Severity="Severity.Success" Dense="true">@_changePasswordSuccess</MudAlert> }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" Disabled="_busy" OnClick="ChangePasswordAsync" FullWidth="true">@(_busy ? L.ChangePasswordBusy : L.ChangePasswordButton)</MudButton>
            </MudForm>
        </MudPaper>
    </main>
}
else if (_showSetupWizard)
{
    <SetupWizard Token="@_token" InitialPhase="@_setupPhase" OnSetupComplete="OnWizardComplete" OnSkipped="OnWizardSkipped" />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0" Class="app-bar">
            <MudText Typo="Typo.h5" Class="app-name">HomeCA <span>LOCAL PKI</span></MudText>
            <MudSpacer />
            @if (_updateAvailable && !string.IsNullOrEmpty(_latestVersion))
            {
                <MudTooltip Text="@($"Version {_latestVersion} verfügbar")">
                    <MudBadge Content="1" Color="Color.Warning" Overlap="true" Bordered="true">
                        <MudIconButton Icon="@Icons.Material.Filled.SystemUpdate" Color="Color.Warning" aria-label="Update verfügbar" OnClick="OpenUpdateRelease" />
                    </MudBadge>
                </MudTooltip>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@L.RefreshAriaLabel" OnClick="LoadAllAsync" Disabled="_busy" />
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout">@L.LogoutButton</MudButton>
        </MudAppBar>
        <MudDrawer Open="true" Variant="DrawerVariant.Responsive" Elevation="0" Class="nav-rail">
            <MudNavMenu>
                @foreach (var entry in Nav)
                {
                    <MudNavLink Class="@NavClass(entry.Key)" OnClick="@(() => _section = entry.Key)">@entry.Value</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent Class="workspace">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="page-loader" />
            }
            @if (!string.IsNullOrEmpty(_pageError)) { <MudAlert Severity="Severity.Error" Class="mb-4">@_pageError</MudAlert> }
            @if (_section == "overview") { @OverviewContent }
            else if (_section == "certificates") { @CertificatesContent }
            else if (_section == "authorities") { @AuthoritiesContent }
            else if (_section == "automation") { @AutomationContent }
            else if (_section == "settings") { @SettingsContent }
            else if (_section == "profiles") { @ProfilesContent }
            else if (_section == "operations") { @OperationsContent }
            else if (_section == "acme") { @AcmeContent }
            else if (_section == "help") { <HelpContent /> }

            @* ── Global dialogs (visible from any section) ── *@
            <MudDialog @bind-Visible="_pfxDialogVisible"><TitleContent><MudText Typo="Typo.h6">PFX-Kennwort festlegen</MudText></TitleContent><DialogContent><MudText Class="mb-3">Das PFX-Archiv wird mit diesem Kennwort verschlüsselt. Verwenden Sie ein starkes Kennwort und geben Sie es nur an das Zielsystem weiter.</MudText><MudTextField @bind-Value="_pfxPassword" Label="Kennwort" InputType="InputType.Password" Required="true" Immediate="true" /><MudTextField Value="_pfxPassword" Label="Kennwort bestätigen" InputType="InputType.Password" ReadOnly="true" Disabled="true" Class="mt-2" /></DialogContent><DialogActions><MudButton OnClick="CancelPfxDialog">Abbrechen</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_pfxPassword) || _busy)" OnClick="DownloadPfx">Herunterladen</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_detailsDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">Zertifikatsdetails</MudText></TitleContent><DialogContent>@if (_certificateDetails is { } d) {
                <MudSimpleTable Dense="true" Bordered="true" Class="details-table"><tbody>
                    <tr><td><strong>Subject</strong></td><td>@d.Subject</td></tr>
                    <tr><td><strong>Aussteller</strong></td><td>@d.Issuer</td></tr>
                    <tr><td><strong>Seriennummer</strong></td><td style="font-family:monospace">@d.SerialNumber</td></tr>
                    <tr><td><strong>SHA-256-Fingerabdruck</strong></td><td style="font-family:monospace;word-break:break-all">@d.Sha256Fingerprint</td></tr>
                    <tr><td><strong>Gültig ab</strong></td><td>@Date(d.ValidFrom)</td></tr>
                    <tr><td><strong>Gültig bis</strong></td><td>@Date(d.ExpiresAt)</td></tr>
                    <tr><td><strong>Algorithmus</strong></td><td>@d.KeyAlgorithm (@(d.KeySize) Bit)</td></tr>
                    <tr><td><strong>Verwendung</strong></td><td>@d.Usage</td></tr>
                    <tr><td><strong>DNS-Namen</strong></td><td>@(d.DnsNames.Count > 0 ? string.Join(", ", d.DnsNames) : "—")</td></tr>
                    <tr><td><strong>IP-Adressen</strong></td><td>@(d.IpAddresses.Count > 0 ? string.Join(", ", d.IpAddresses) : "—")</td></tr>
                    <tr><td><strong>Erweiterte Schlüsselverwendung</strong></td><td>@(d.EnhancedKeyUsages.Count > 0 ? string.Join(", ", d.EnhancedKeyUsages) : "—")</td></tr>
                    <tr><td><strong>Zertifikat-ID</strong></td><td style="font-family:monospace">@d.Id</td></tr>
                </tbody></MudSimpleTable>
            }</DialogContent><DialogActions><MudButton OnClick="CloseDetailsDialog">Schließen</MudButton></DialogActions></MudDialog>
            <MudDialog @bind-Visible="_sshCertDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })"><TitleContent><MudText Typo="Typo.h6">SSH-Zertifikat — @_sshCertDialogIdentity</MudText></TitleContent><DialogContent><MudText Class="mb-3">Kopieren Sie den Zertifikatsinhalt oder laden Sie die Datei herunter.</MudText><CodePreview Text="@(_sshCertDialogContent ?? string.Empty)" Lines="4" />
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-2">@(_sshCertDialogKind == "host" ? "Host-Zertifikat einspielen" : "Benutzerzertifikat verwenden")</MudText>
            @if (_sshCertDialogKind == "host") {
                <MudText Class="mud-text-secondary mb-2">Speichere das Zertifikat auf dem Server neben dem Host-Key und aktiviere es in der sshd_config.</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">1. Zertifikat auf den Server schreiben</MudText>
                <CodePreview Text="@SshHostDeployScript" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">2. sshd_config ergänzen</MudText>
                <CodePreview Text="@SshHostSshdConfigScript" Lines="2" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">3. SSH-Daemon neu laden</MudText>
                <CodePreview Text="@SshReloadSshdScript" Lines="2" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">Damit Clients das Host-Zertifikat akzeptieren, muss die Host-CA in <code>known_hosts</code> eingetragen sein — siehe Abschnitt „Vertrauensstellung" unten.</MudAlert>
            } else {
                <MudText Class="mud-text-secondary mb-2">Speichere das Zertifikat neben dem privaten Schlüssel. SSH findet es automatisch über die Namenskonvention.</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">1. Zertifikat speichern</MudText>
                <CodePreview Text="@SshUserDeployScript" Lines="2" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">2. Verbindung testen</MudText>
                <CodePreview Text="@SshUserTestScript" Lines="2" />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">Damit der Server das Benutzerzertifikat akzeptiert, muss <code>TrustedUserCAKeys</code> in der <code>sshd_config</code> konfiguriert sein — siehe Abschnitt „Vertrauensstellung" unten.</MudAlert>
            }
            <MudDivider Class="my-4" />
            <MudExpansionPanels MultiExpansion="true" Elevation="0">
                <MudExpansionPanel Text="Vertrauensstellung einrichten">
                    @if (_sshCertDialogKind == "host") {
                        <MudText Class="mud-text-secondary mb-2">Trage die Host-CA in die <code>known_hosts</code> der Clients ein, damit signierte Host-Keys ohne Fingerprint-Abfrage akzeptiert werden.</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Einzelner Benutzer</MudText>
                        <CodePreview Text="@SshHostTrustUserScript" Lines="2" />
                        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Systemweit</MudText>
                        <CodePreview Text="@SshHostTrustSystemScript" Lines="2" />
                    } else {
                        <MudText Class="mud-text-secondary mb-2">Konfiguriere den Zielserver, damit er Benutzerzertifikate der User-CA akzeptiert.</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">User-CA auf den Server kopieren und sshd_config ergänzen</MudText>
                        <CodePreview Text="@SshUserTrustScript" Lines="5" />
                    }
                </MudExpansionPanel>
                <MudExpansionPanel Text="Zertifikat prüfen">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Zertifikatsinhalt anzeigen</MudText>
                    <CodePreview Text="@SshVerifyScript" Lines="2" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            </DialogContent><DialogActions><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="DownloadSshCertificateFile">Herunterladen</MudButton><MudButton OnClick="CloseSshCertDialog">Schließen</MudButton></DialogActions></MudDialog>

        </MudMainContent>
    </MudLayout>
}

@code {
    private (string Key, string Value)[] Nav => [("overview", L.NavOverview), ("certificates", L.NavCertificates), ("authorities", L.NavAuthorities), ("acme", L.NavAcme), ("automation", L.NavAutomation), ("settings", L.NavSettings), ("profiles", L.NavProfiles), ("operations", L.NavOperations), ("help", L.NavHelp)];
    private const string Tls = "TLS", ClientUsage = "mTLS", Ecc = "ECC", Rsa = "RSA", RootAuthority = "root", IntermediateAuthority = "intermediate", HostKind = "host", UserKind = "user", Hetzner = "hetzner", Technitium = "technitium", Unspecified = "unspecified", KeyCompromise = "keyCompromise", CessationOfOperation = "cessationOfOperation";
    private readonly JsonSerializerOptions _json = new(JsonSerializerDefaults.Web);
    private string? _token, _loginUser, _loginPassword, _loginError, _pageError, _connectorCheckMessage, _editingConnectorId, _editingDomainName, _editingAuthorityId, _editingProfileId, _deleteAuthorityId, _deleteProfileId, _deleteCertificateId;
    private string _section = "overview";
    private bool _busy, _loading, _loginValid, _mustChangePassword, _showSetupWizard;
    private string _setupPhase = "initial";
    private bool _isFirstLogin = true;
    private List<DnsCheckResult> _dnsCheckResults = [];
    private MudForm? _loginForm, _changePasswordForm;
    private string _currentPassword = "", _newPassword = "", _confirmPassword = "";
    private string? _changePasswordError, _changePasswordSuccess;
    private bool _changePasswordValid;
    private List<Certificate> _certificates = [];
    private List<Authority> _authorities = [];
    private List<Domain> _domains = [];
    private List<Connector> _connectors = [];
    private List<TargetProfileDto> _profiles = [];
    private List<RenewalPlan> _plans = [];
    private List<ExternalIssuer> _issuers = [];
    private List<ExpiryWarning> _warnings = [];
    private List<Revocation> _revocations = [];
    private List<AcmeAccountFull> _acmeAccounts = [];
    private List<AcmeOrderFull> _acmeOrders = [];
    private List<Rfc8555AccountDto> _rfc8555Accounts = [];
    private List<Rfc8555OrderDto> _rfc8555Orders = [];
    private List<ExternalAcmeCertDto> _externalCerts = [];
    private string? _deleteRfc8555AccountId, _deleteRfc8555OrderId, _deleteAcmeAccountId, _deleteAcmeOrderId;
    private List<SshCertificateItem> _sshCertificates = [];
    private string? _editingIssuerId, _deleteIssuerId;
    private AcmeOrderFull? _checkedOrder;
    private string _pfxPassword = "", _pfxCertificateId = "";
    private bool _pfxDialogVisible, _detailsDialogVisible, _sshCertDialogVisible;
    private CertificateDetailsDto? _certificateDetails;
    private string? _sshCertDialogContent, _sshCertDialogIdentity, _sshCertDialogKind, _deleteSshCertificateId;
    private string? _deleteConnectorId, _deleteDomainName, _editingPlanId, _deletePlanId;
    private string _lastBackupFileName = "";
    private string? _deleteBackupFileName;
    private List<BackupListItem> _backups = [];
    private bool _updateAvailable;
    private string? _latestVersion, _releaseUrl;

    private RenderFragment OverviewContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">@L.OverviewKicker</MudText><MudText Typo="Typo.h3" Class="page-title">@L.OverviewTitle</MudText>
        <div class="metric-grid"><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@L.MetricCertificates</MudText><MudText Typo="Typo.h3">@_certificates.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@L.MetricCAs</MudText><MudText Typo="Typo.h3">@_authorities.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@L.MetricRenewals</MudText><MudText Typo="Typo.h3">@_plans.Count(p => p.Enabled)</MudText></MudPaper></div>
        @if (_warnings.Count > 0) { <MudAlert Severity="Severity.Warning" Class="mb-4"><b>@L.ExpiryWarning(_warnings.Count)</b><br />@string.Join(" · ", _warnings.Select(w => $"{w.Subject} ({L.ExpiryDays(w.DaysRemaining)})"))</MudAlert> }
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.TrustAnchorTitle</MudText><MudText Class="mud-text-secondary mb-3">@L.TrustAnchorDescription</MudText><div class="d-flex gap-2 flex-wrap"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadTrustAnchor("pem"))">@L.TrustAnchorPem</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadTrustAnchor("der"))">@L.TrustAnchorDer</MudButton></div></MudPaper>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.LatestCertificates</MudText>@CertificateTable(_certificates.Take(5))</MudPaper>
    </text>;

    private RenderFragment CertificatesContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">X.509 und SSH</MudText><MudText Typo="Typo.h3" Class="page-title">Zertifikate ausstellen</MudText>
        <MudGrid><MudItem xs="12" lg="8"><MudPaper Class="panel" Elevation="0"><MudTabs Rounded="false" PanelClass="pt-4"><MudTabPanel Text="TLS- und mTLS-Zertifikat">@CertificateIssueForm</MudTabPanel><MudTabPanel Text="SSH-Zertifikat">@SshIssueForm</MudTabPanel><MudTabPanel Text="Interne ACME">@AcmeForm</MudTabPanel></MudTabs></MudPaper></MudItem><MudItem xs="12" lg="4"><MudPaper Class="panel issue-note" Elevation="0">@CertificateProfileSummary</MudPaper></MudItem></MudGrid>
        <MudPaper Class="panel"><MudText Typo="Typo.h5">Zertifikatsinventar</MudText>@CertificateTable(_certificates)</MudPaper>
        <MudPaper Class="panel"><MudText Typo="Typo.h5">SSH-Zertifikatsinventar</MudText><MudTable Items="_sshCertificates" Dense="true" Hover="true"><HeaderContent><MudTh>Identität</MudTh><MudTh>Art</MudTh><MudTh>Principals</MudTh><MudTh>Ausgestellt</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Identity</MudTd><MudTd>@(context.Kind == "host" ? "Host" : "Benutzer")</MudTd><MudTd>@context.Principals</MudTd><MudTd>@Date(context.IssuedAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadSshCertificate(context.Id, context.Identity, context.Kind))">Zertifikat</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteSshCertificate(context.Id))">@(_deleteSshCertificateId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Noch keine SSH-Zertifikate ausgestellt.</MudText></NoRecordsContent></MudTable></MudPaper>
    </text>;

    private RenderFragment AuthoritiesContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">Vertrauenshierarchie und Sperrlisten</MudText><MudText Typo="Typo.h3" Class="page-title">Zertifizierungsstellen</MudText>
        <MudGrid><MudItem xs="12" md="4"><MudPaper Class="panel" Elevation="0">@AuthorityForm</MudPaper></MudItem><MudItem xs="12" md="8"><MudPaper Class="panel" Elevation="0"><MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3"><MudText Typo="Typo.h6">CA-Inventar</MudText><MudSpacer /><MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="StartIntermediate" Disabled="@(!_authorities.Any(a => a.Type == RootAuthority && a.IsActive && !a.IsRevoked))">Neue Intermediate-CA</MudButton></MudStack><MudTable Items="_authorities" Dense="true" Hover="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Typ</MudTh><MudTh>Subject</MudTh><MudTh>Status</MudTh><MudTh>CRL</MudTh><MudTh>Läuft ab</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@(context.Type == "root" ? "Root" : "Intermediate")</MudTd><MudTd>@context.Subject</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsRevoked ? Color.Error : context.IsActive ? Color.Success : Color.Default)">@AuthorityStatus(context)</MudChip></MudTd><MudTd>@context.CrlValidityDays Tage</MudTd><MudTd>@Date(context.ExpiresAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadAuthority(context.Id, "pem"))">PEM</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadAuthority(context.Id, "der"))">Windows CER</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginAuthorityEdit(context))">Bearbeiten</MudButton>@if (!context.IsRevoked) { <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" OnClick="@(() => RevokeAuthority(context.Id))">Sperren</MudButton> }<MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAuthority(context.Id))">@(_deleteAuthorityId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Legen Sie zuerst eine Root-CA an.</MudText></NoRecordsContent></MudTable></MudPaper></MudItem></MudGrid>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">SSH-Zertifizierungsstellen</MudText><MudText Class="mud-text-secondary mb-3">Die öffentlichen Schlüssel der SSH-CAs werden benötigt, um die Vertrauensstellung auf Servern und Clients einzurichten.</MudText><div class="d-flex gap-2 flex-wrap"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadSshCaKey("host"))">Host-CA Public Key</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadSshCaKey("user"))">User-CA Public Key</MudButton></div></MudPaper>
    </text>;

    private RenderFragment AutomationContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">Abläufe vorbereiten</MudText><MudText Typo="Typo.h3" Class="page-title">Erneuerungsautomatik</MudText><MudGrid><MudItem xs="12" md="5"><MudPaper Class="panel" Elevation="0">@RenewalForm</MudPaper></MudItem><MudItem xs="12" md="7"><MudPaper Class="panel" Elevation="0"><MudTable Items="_plans" Dense="true"><HeaderContent><MudTh>Zertifikat</MudTh><MudTh>Tage vorher</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@CertificateName(context.CertificateId)</MudTd><MudTd>@context.RenewBeforeDays</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)">@(context.Enabled ? "Aktiv" : "Inaktiv")</MudChip></MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginPlanEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeletePlan(context.Id))">@(_deletePlanId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate></MudTable></MudPaper></MudItem></MudGrid>
    </text>;

    private RenderFragment SettingsContent => @<text>
        @if (!string.IsNullOrEmpty(_connectorCheckMessage)) { <MudAlert Severity="@(_connectorCheckMessage.StartsWith("Verbindung hergestellt", StringComparison.Ordinal) ? Severity.Success : Severity.Error)" Class="mb-4">@_connectorCheckMessage</MudAlert> }
        <MudText Typo="Typo.overline" Class="section-kicker">Externe Dienste und Zonen</MudText><MudText Typo="Typo.h3" Class="page-title">Einstellungen</MudText><MudGrid><MudItem xs="12" lg="4"><MudPaper Class="panel" Elevation="0">@ConnectorForm</MudPaper></MudItem><MudItem xs="12" lg="4"><MudPaper Class="panel" Elevation="0">@DomainForm</MudPaper></MudItem><MudItem xs="12" lg="4"><MudPaper Class="panel" Elevation="0">@IssuerForm</MudPaper></MudItem></MudGrid><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">Gespeicherte DNS-Connectoren</MudText><MudTable Items="_connectors" Dense="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Typ</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Type</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginConnectorEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => CheckConnector(context.Id))">@(context.Type == Hetzner ? "Hetzner prüfen" : "Technitium prüfen")</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => TxtTestConnector(context.Id))">TXT-Test</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteConnector(context.Id))">@(_deleteConnectorId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate></MudTable></MudPaper><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">Gespeicherte Domains</MudText><MudTable Items="_domains" Dense="true"><HeaderContent><MudTh>Domain</MudTh><MudTh>Ausstellungszone</MudTh><MudTh>DNS-Connector</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@(context.InternalIssuanceEnabled ? "Intern" : "Extern")</MudTd><MudTd>@ConnectorName(context.ConnectorId)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginDomainEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteDomain(context.Name))">@(_deleteDomainName == context.Name ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate></MudTable></MudPaper><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">Externe ACME-Issuer</MudText><MudTable Items="_issuers" Dense="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Directory-URL</MudTh><MudTh>DNS-Connector</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd><MudText Typo="Typo.caption">@context.DirectoryUrl</MudText></MudTd><MudTd>@ConnectorName(context.ConnectorId)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginIssuerEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIssuer(context.Id))">@(_deleteIssuerId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Noch keine externen ACME-Issuer registriert.</MudText></NoRecordsContent></MudTable></MudPaper>
        <MudPaper Class="panel mt-4" Elevation="0">
            <MudText Typo="Typo.h5">TLS für HomeCA-Oberfläche</MudText>
            <MudText Class="mud-text-secondary mb-3">
                HomeCA stellt sich selbst ein TLS-Zertifikat aus und ist danach nur noch über HTTPS (Port 5443) erreichbar.
                Die CA muss dafür bereits eingerichtet sein.
            </MudText>
            @if (!string.IsNullOrEmpty(_tlsSettingsSuccess))
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@_tlsSettingsSuccess</MudAlert>
                @if (_tlsActivated)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        HomeCA startet neu und ist gleich unter HTTPS erreichbar. Diese Seite wird automatisch weitergeleitet.
                    </MudAlert>
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mb-3" />
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_tlsActivateError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_tlsActivateError</MudAlert>
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            Alternativ auf dem Host ausführen:
                        </MudAlert>
                        <CodePreview Text="@_tlsRestartCommand" Lines="2" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mt-3"
                        Disabled="_busy" OnClick="ApplyTlsAndRestartAsync"
                        StartIcon="@Icons.Material.Filled.RestartAlt">
                        @(_busy ? "TLS wird aktiviert …" : "TLS jetzt aktivieren und neu starten")
                    </MudButton>
                }
            }
            else
            {
                <MudForm @ref="_tlsSettingsForm" @bind-IsValid="_tlsSettingsValid">
                    <MudTextField @bind-Value="_tlsHostname" Label="Hostname" Placeholder="homeca.home.local"
                        Required="true" RequiredError="Hostname ist erforderlich" Immediate="true"
                        HelperText="DNS-Name für das TLS-Zertifikat" />
                    <MudTextField @bind-Value="_tlsIpAddress" Label="IP-Adresse (optional)" Placeholder="10.5.0.131"
                        Immediate="true" HelperText="Wird als zusätzlicher SAN aufgenommen" Class="mt-2" />
                </MudForm>
                @if (!string.IsNullOrEmpty(_tlsSettingsError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_tlsSettingsError</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                    Disabled="@(!_tlsSettingsValid || _busy)" OnClick="ActivateTlsAsync">
                    @(_busy ? "TLS wird eingerichtet …" : "TLS-Zertifikat ausstellen und aktivieren")
                </MudButton>
            }
        </MudPaper>
        <MudPaper Class="panel mt-4" Elevation="0"><MudText Typo="Typo.h5">Ersteinrichtung</MudText><MudText Class="mud-text-secondary mb-3">Den Setup-Assistenten erneut durchlaufen, um z. B. Hostname, DNS-Connector oder CA-Einrichtung zu wiederholen.</MudText><MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy" OnClick="ResetSetupWizardAsync" StartIcon="@Icons.Material.Filled.RestartAlt">Ersteinrichtung wiederholen</MudButton></MudPaper>
    </text>;

    private RenderFragment ProfilesContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">Zielsysteme und Exportvorgaben</MudText><MudText Typo="Typo.h3" Class="page-title">Profile</MudText>
        <MudGrid><MudItem xs="12" lg="4"><MudPaper Class="panel" Elevation="0">@ProfileForm</MudPaper></MudItem><MudItem xs="12" lg="8"><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">Zielprofile</MudText><MudTable Items="_profiles" Dense="true" Hover="true"><HeaderContent><MudTh>Name</MudTh><MudTh>ID</MudTh><MudTh>Version</MudTh><MudTh>Algorithmus</MudTh><MudTh>Exporte</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@ProfileDisplayName(context)</MudTd><MudTd>@context.Id</MudTd><MudTd>@context.Version</MudTd><MudTd>@ProfileKeyAlgorithm(context)</MudTd><MudTd>@string.Join(", ", ProfileExportFormats(context))</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginProfileEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteProfile(context.Id))">@(_deleteProfileId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Es sind noch keine Zielprofile angelegt.</MudText></NoRecordsContent></MudTable></MudPaper></MudItem></MudGrid>
    </text>;

    private RenderFragment OperationsContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">Sperrung und Wiederherstellbarkeit</MudText><MudText Typo="Typo.h3" Class="page-title">Betrieb</MudText><MudGrid><MudItem xs="12" lg="5"><MudPaper Class="panel" Elevation="0">@RevocationForm<MudDivider Class="my-4" /><MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="_busy" OnClick="GenerateCrl">Sperrliste erzeugen</MudButton></MudPaper></MudItem><MudItem xs="12" lg="7"><MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h6">Sperrungen</MudText><MudTable Items="_revocations" Dense="true"><HeaderContent><MudTh>Seriennummer</MudTh><MudTh>Grund</MudTh><MudTh>Datum</MudTh></HeaderContent><RowTemplate><MudTd>@context.SerialNumber</MudTd><MudTd>@context.Reason</MudTd><MudTd>@Date(context.RevokedAt)</MudTd></RowTemplate></MudTable></MudPaper></MudItem></MudGrid>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h6">Backup-Schlüssel</MudText><MudText Class="mb-3">Der 32-Byte AES-256-Schlüssel verschlüsselt alle Backups. Sichern Sie diesen Schlüssel getrennt von den Backups auf.</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="DownloadBackupKey" StartIcon="@Icons.Material.Filled.Download">Schlüssel herunterladen</MudButton>
            <MudFileUpload T="IBrowserFile" Accept=".key" FilesChanged="UploadBackupKey" Class="d-inline-flex ml-2" MaximumFileCount="1"><ActivatorContent><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy" StartIcon="@Icons.Material.Filled.Upload">Schlüssel hochladen</MudButton></ActivatorContent></MudFileUpload>
        </MudPaper>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h6">Verschlüsseltes Backup</MudText><MudText Class="mb-3">Erstellt ein verschlüsseltes Archiv der HomeCA-Daten.</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="CreateBackup" StartIcon="@Icons.Material.Filled.AddCircle">Backup erstellen</MudButton>
            <MudFileUpload T="IBrowserFile" Accept=".hcab" FilesChanged="UploadBackup" Class="d-inline-flex ml-2" MaximumFileCount="1"><ActivatorContent><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy" StartIcon="@Icons.Material.Filled.Upload">Backup hochladen</MudButton></ActivatorContent></MudFileUpload>
            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="LoadBackupList" StartIcon="@Icons.Material.Filled.Refresh" Class="ml-2">Aktualisieren</MudButton>
            @if (_backups.Count > 0) {
            <MudTable Items="_backups" Dense="true" Class="mt-4"><HeaderContent><MudTh>Dateiname</MudTh><MudTh>Größe</MudTh><MudTh>Erstellt</MudTh><MudTh></MudTh></HeaderContent><RowTemplate>
                <MudTd DataLabel="Dateiname">@context.FileName</MudTd>
                <MudTd DataLabel="Größe">@FormatBytes(context.Size)</MudTd>
                <MudTd DataLabel="Erstellt">@Date(context.CreatedAt)</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadBackupByName(context.FileName))" StartIcon="@Icons.Material.Filled.Download">Download</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => VerifyBackupByName(context.FileName))">Verifizieren</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBackup(context.FileName))">@(_deleteBackupFileName == context.FileName ? "Löschen bestätigen" : "Löschen")</MudButton>
                </MudTd>
            </RowTemplate><NoRecordsContent><MudText Class="pa-4">Keine Backups vorhanden.</MudText></NoRecordsContent></MudTable>
            }
        </MudPaper>
    </text>;

    private string _dnsNames = "", _ipAddresses = "", _keyAlgorithm = "ECC", _certificateUsage = "TLS", _selectedProfileId = "", _sshKind = "host", _sshIdentity = "", _sshPrincipals = "", _sshPublicKey = "", _renewalCertificate = "", _connectorName = "", _connectorType = "hetzner", _connectorSecret = "", _connectorEndpoint = "", _domainName = "", _domainConnector = "", _issuerName = "", _issuerUrl = "", _issuerConnector = "", _serialNumber = "", _revocationReason = "unspecified", _acmeContact = "", _acmeAccountId = "", _acmeIdentifiers = "", _acmeOrderId = "", _authorityName = "", _authoritySubject = "CN=HomeCA Root CA", _authorityType = "root", _authorityParent = "", _authorityKeyAlgorithm = "ECC", _profileId = "", _profileVersion = "1.0", _profileDisplayName = "", _profilePurpose = "", _profileKeyAlgorithm = "ECC", _profileExportFormats = "PEM", _profileDocumentation = "", _profileRenewalScript = "";
    private int _validityDays = 365, _rsaKeySize = 2048, _renewBeforeDays = 30, _authorityValidityDays = 3650, _authorityCrlValidityDays = 7, _profileMaximumValidityDays = 730;
    private bool _internalIssuance = true, _authorityActive = true, _profileRequiresDnsName = true, _profileAllowsIpAddress = true, _renewalEnabled = true;

    private RenderFragment CertificateTable(IEnumerable<Certificate> items) => @<MudTable Items="items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"><HeaderContent><MudTh>Subject</MudTh><MudTh>Algorithmus</MudTh><MudTh>Läuft ab</MudTh><MudTh>Download</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd DataLabel="Subject">@context.Subject</MudTd><MudTd DataLabel="Algorithmus">@context.KeyAlgorithm</MudTd><MudTd DataLabel="Läuft ab">@Date(context.ExpiresAt)</MudTd><MudTd DataLabel="Download"><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadCertificateExport(context.Id, "pem"))">PEM</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadCertificateExport(context.Id, "key"))">Key</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadCertificateExport(context.Id, "chain"))">Chain</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadCertificateExport(context.Id, "fullchain"))">Fullchain</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DownloadCertificateExport(context.Id, "bundle"))">Bundle</MudButton><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => OpenPfxDialog(context.Id))">PFX</MudButton></MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => ShowCertificateDetails(context.Id))">Details</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCertificate(context.Id))">@(_deleteCertificateId == context.Id ? "Widerruf bestätigen" : "Widerrufen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Noch keine Zertifikate ausgestellt.</MudText></NoRecordsContent></MudTable>;
    private RenderFragment AuthorityForm => @<div class="form-stack"><MudText Typo="Typo.h6">@(_editingAuthorityId is null ? "CA anlegen" : "CA verwalten")</MudText><MudTextField @bind-Value="_authorityName" Label="Name" Required="true" /><MudTextField @bind-Value="_authoritySubject" Label="Subject (DN)" Required="true" Disabled="@(_editingAuthorityId is not null)" /><MudSelect T="string" Label="Typ" @bind-Value="_authorityType" Disabled="@(_editingAuthorityId is not null)"><MudSelectItem Value="@RootAuthority">Root-CA</MudSelectItem><MudSelectItem Value="@IntermediateAuthority">Intermediate-CA</MudSelectItem></MudSelect>@if (_authorityType == IntermediateAuthority) { <MudSelect T="string" Label="Übergeordnete Root-CA" @bind-Value="_authorityParent" Required="true" Disabled="@(_editingAuthorityId is not null)">@foreach(var authority in _authorities.Where(a => a.Type == RootAuthority && a.IsActive && !a.IsRevoked)) { <MudSelectItem Value="@authority.Id">@authority.Name</MudSelectItem> }</MudSelect> }<MudNumericField T="int" @bind-Value="_authorityValidityDays" Label="Laufzeit (Tage)" Min="1" Max="7300" Disabled="@(_editingAuthorityId is not null)" /><MudSelect T="string" Label="Schlüsselalgorithmus" @bind-Value="_authorityKeyAlgorithm" Disabled="@(_editingAuthorityId is not null)"><MudSelectItem Value="@Ecc">ECC P-256</MudSelectItem><MudSelectItem Value="@Rsa">RSA 3072</MudSelectItem></MudSelect><MudNumericField T="int" @bind-Value="_authorityCrlValidityDays" Label="CRL-Gültigkeit (Tage)" Min="1" Max="365" />@if (_editingAuthorityId is not null) { <MudCheckBox @bind-Value="_authorityActive" Label="Für neue Ausstellungen aktiv" /> }<MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveAuthority">@(_editingAuthorityId is null ? "CA erstellen" : "Änderungen speichern")</MudButton>@if (_editingAuthorityId is not null) { <MudButton Variant="Variant.Text" OnClick="CancelAuthorityEdit">Bearbeiten abbrechen</MudButton> }</div>;
    private RenderFragment CertificateIssueForm => @<div class="form-stack"><div class="assistant-stage"><MudText Typo="Typo.overline" Class="section-kicker">Schritt 1</MudText><MudText Typo="Typo.h6">Zielsystem wählen</MudText><MudText Class="mud-text-secondary">Das Zielprofil setzt Standardwerte für Algorithmus, Laufzeit, Exporte und Einspielhinweise.</MudText></div><MudSelect T="string" Label="Zielprofil" Value="_selectedProfileId" ValueChanged="SelectProfile" Required="true">@foreach (var profile in _profiles) { <MudSelectItem Value="@profile.Id">@ProfileDisplayName(profile)</MudSelectItem> }</MudSelect><div class="assistant-stage"><MudText Typo="Typo.overline" Class="section-kicker">Schritt 2</MudText><MudText Typo="Typo.h6">Zertifikat definieren</MudText></div><MudSelect T="string" Label="Verwendung" @bind-Value="_certificateUsage"><MudSelectItem T="string" Value="@Tls">TLS-Server</MudSelectItem><MudSelectItem T="string" Value="@ClientUsage">mTLS / Client</MudSelectItem></MudSelect><MudTextField @bind-Value="_dnsNames" Label="DNS-Namen" HelperText="@DnsHelperText" Required="@ProfileRequiresDnsName(SelectedProfile)" Validation="@(new Func<string, string?>(ValidateDnsNames))" Immediate="true" /><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Dns" Disabled="@(_busy || string.IsNullOrWhiteSpace(_dnsNames))" OnClick="CheckDnsNamesAsync" Class="mt-n2">DNS prüfen</MudButton>@if (_dnsCheckResults.Count > 0) { <div class="mt-1">@foreach (var r in _dnsCheckResults) { <MudAlert Severity="@r.Severity" Dense="true" Class="mb-1">@r.Message</MudAlert> }</div> }<MudTextField @bind-Value="_ipAddresses" Label="IP-Adressen" HelperText="@IpHelperText" Disabled="@(!AllowsIpAddresses)" /><MudNumericField T="int" @bind-Value="_validityDays" Label="Gültigkeit in Tagen" Min="1" Max="@EffectiveValidityLimit" HelperText="@ValidityHelperText" /><MudSelect T="string" Label="Schlüsselalgorithmus" @bind-Value="_keyAlgorithm" Disabled="@ProfileForcesRsa"><MudSelectItem T="string" Value="@Ecc">ECC</MudSelectItem><MudSelectItem T="string" Value="@Rsa">RSA</MudSelectItem></MudSelect>@if (ProfileForcesRsa) { <MudAlert Severity="Severity.Info" Dense="true">Dieses Zielprofil erzwingt RSA. Die Abweichung zur Standardwahl ECC ist hier bewusst sichtbar.</MudAlert> }@if (_keyAlgorithm == Rsa) { <MudNumericField T="int" @bind-Value="_rsaKeySize" Label="RSA-Schlüssellänge" Min="2048" Max="3072" HelperText="Legacy-Profile verwenden RSA 2048 oder 3072 Bit." /> }<div class="assistant-stage"><MudText Typo="Typo.overline" Class="section-kicker">Schritt 3</MudText><MudText Typo="Typo.h6">Deployment-Paket erzeugen</MudText><MudText Class="mud-text-secondary">HomeCA speichert beim Ausstellen einen versionsierten Snapshot mit Exporten, Anleitung, Prüfsummen und Erneuerungsskript.</MudText></div><MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_busy" OnClick="IssueCertificate">@CertificateActionLabel</MudButton></div>;
    private RenderFragment CertificateProfileSummary => @<div class="profile-summary"><MudText Typo="Typo.h6">Ausstellungsweg</MudText><MudText>Die privaten Schlüssel und Exportpfade verbleiben auf dem HomeCA-Host. Der Ablauf startet mit dem Zielsystem und leitet daraus die Zertifikatsparameter ab.</MudText>@if (SelectedProfile is { } profile) { <MudDivider Class="my-4" /><MudText Typo="Typo.overline" Class="section-kicker">Aktives Zielprofil</MudText><MudText Typo="Typo.h5" Class="page-title compact-title">@ProfileDisplayName(profile)</MudText><MudText>@ProfilePurpose(profile)</MudText><MudText Typo="Typo.caption">Version @ProfileVersion(profile)</MudText><div class="chip-row">@foreach (var format in ProfileExportFormats(profile)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@format</MudChip> }</div><div class="profile-facts"><div class="profile-fact"><strong>Standardalgorithmus:</strong> @ProfileKeyAlgorithm(profile)</div><div class="profile-fact"><strong>Maximale Laufzeit:</strong> @ProfileMaximumValidityDays(profile) Tage</div><div class="profile-fact"><strong>DNS-SAN:</strong> @(ProfileRequiresDnsName(profile) ? "erforderlich" : "optional")</div><div class="profile-fact"><strong>IP-SAN:</strong> @(ProfileAllowsIpAddress(profile) ? "erlaubt" : "nicht vorgesehen")</div></div><MudAlert Severity="Severity.Info" Dense="true">Deployment-Paket: @string.Join(", ", ProfileExportFormats(profile)) sowie profilgebundene Anleitung und Skript-Snapshot.</MudAlert><MudText Typo="Typo.body2" Class="mt-3">@ProfileDocumentation(profile)</MudText><MudText Typo="Typo.caption" Class="mt-2">Skript-Vorschau</MudText><CodePreview Text="@ProfileRenewalScript(profile)" Lines="5" /> } else { <MudAlert Severity="Severity.Warning" Dense="true">Es ist kein Zielprofil geladen. Ohne Profil fehlen Exporte und profilbezogene Vorgaben.</MudAlert> }</div>;
