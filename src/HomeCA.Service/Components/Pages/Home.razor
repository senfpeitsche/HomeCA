    // ── TLS settings ────────────────────────────────────────────────────────
    private string _tlsHostname = "", _tlsIpAddress = "";
    private string? _tlsSettingsError, _tlsSettingsSuccess, _tlsRestartCommand, _tlsActivateError;
    private bool _tlsSettingsValid, _tlsActivated;
    private MudForm? _tlsSettingsForm;

    private async Task ActivateTlsAsync()
    {
        if (_tlsSettingsForm is not null) { await _tlsSettingsForm.Validate(); if (!_tlsSettingsValid) return; }
        if (string.IsNullOrWhiteSpace(_tlsHostname)) { _tlsSettingsError = "Hostname ist erforderlich."; return; }

        _busy = true;
        _tlsSettingsError = null;
        _tlsSettingsSuccess = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/setup/activate-tls", new
            {
                hostname = _tlsHostname,
                ipAddress = string.IsNullOrWhiteSpace(_tlsIpAddress) ? null : _tlsIpAddress
            });
            if (!response.IsSuccessStatusCode)
            {
                _tlsSettingsError = await response.Content.ReadAsStringAsync();
                return;
            }
            _tlsSettingsSuccess = $"TLS-Zertifikat für {_tlsHostname} ausgestellt. Nach dem Neustart ist HomeCA unter https://{_tlsHostname}:5443 erreichbar.";
            _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
            Snackbar.Add("TLS-Zertifikat ausgestellt.", Severity.Success);
        }
        catch (Exception ex) { _tlsSettingsError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ApplyTlsAndRestartAsync()
    {
        _busy = true;
        _tlsActivateError = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsync("api/v1/system/activate-tls", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _tlsActivateError = $"Aktivierung fehlgeschlagen: {body}";
                _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
                return;
            }
            _tlsActivated = true;
            Snackbar.Add("TLS wird aktiviert — HomeCA startet neu.", Severity.Success);

            // Redirect to HTTPS after a short delay to let the service restart
            _ = Task.Run(async () =>
            {
                await Task.Delay(6000);
                var httpsUrl = $"https://{_tlsHostname}:5443";
                await InvokeAsync(() => Navigation.NavigateTo(httpsUrl, true));
            });
        }
        catch (Exception ex)
        {
            _tlsActivateError = ex.Message;
            _tlsRestartCommand = "bash /opt/homeca/homeca-activate-tls.sh";
        }
        finally { _busy = false; }
    }

