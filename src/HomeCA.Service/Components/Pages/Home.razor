    protected override async Task OnInitializedAsync() => await LoadInstanceAsync();

    private HttpClient Client()
    {
        var client = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
        if (!string.IsNullOrEmpty(_token)) client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _token);
        return client;
    }
    private async Task LoadInstanceAsync() { try { using var client = Client(); await client.GetFromJsonAsync<Instance>("api/v1/instance", _json); var phase = await client.GetFromJsonAsync<SetupPhaseDto>("api/v1/setup/phase", _json); _isFirstLogin = phase?.Phase == "initial"; } catch { } }
    private async Task LoginAsync()
    {
        await _loginForm!.Validate(); if (!_loginValid) return;
        _busy = true; _loginError = null;
        try { using var client = Client(); var response = await client.PostAsJsonAsync("api/v1/login", new { userName = _loginUser, password = _loginPassword }); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(); var result = await response.Content.ReadFromJsonAsync<LoginResult>(_json); _token = result?.AccessToken ?? throw new InvalidOperationException(); _mustChangePassword = result.MustChangePassword; if (!_mustChangePassword) { await CheckSetupStateAsync(); if (!_showSetupWizard) await LoadAllAsync(); } }
        catch { _loginError = "Benutzername oder Passwort sind nicht korrekt."; }
        finally { _busy = false; }
    }
    private void Logout() { _token = null; _loginPassword = null; _section = "overview"; _mustChangePassword = false; _currentPassword = ""; _newPassword = ""; _confirmPassword = ""; _changePasswordError = null; _changePasswordSuccess = null; ClearData(); Snackbar.Add("Sie wurden abgemeldet.", Severity.Info); }
    private void ClearData() { _certificates=[]; _authorities=[]; _domains=[]; _connectors=[]; _profiles=[]; _plans=[]; _issuers=[]; _warnings=[]; _revocations=[]; _acmeAccounts=[]; _acmeOrders=[]; _rfc8555Accounts=[]; _rfc8555Orders=[]; _externalCerts=[]; _sshCertificates=[]; _checkedOrder=null; _selectedProfileId = ""; }
    private async Task ChangePasswordAsync()
    {
        await _changePasswordForm!.Validate(); if (!_changePasswordValid) return;
        if (_newPassword != _confirmPassword) { _changePasswordError = L.ChangePasswordMismatch; return; }
        if (_newPassword.Length < 12) { _changePasswordError = L.ChangePasswordTooShort; return; }
        _busy = true; _changePasswordError = null; _changePasswordSuccess = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/change-password", new { currentPassword = _currentPassword, newPassword = _newPassword });
            if (!response.IsSuccessStatusCode) { _changePasswordError = L.ChangePasswordError; return; }
            _changePasswordSuccess = L.ChangePasswordSuccess;
            _mustChangePassword = false; _token = null; _loginPassword = null; _currentPassword = ""; _newPassword = ""; _confirmPassword = "";
        }
        catch { _changePasswordError = L.ChangePasswordError; }
        finally { _busy = false; }
    }
    private string? ValidateNewPassword(string value) => !string.IsNullOrEmpty(value) && value.Length < 12 ? L.ChangePasswordTooShort : null;
    private string? ValidateConfirmPassword(string value) => !string.IsNullOrEmpty(value) && value != _newPassword ? L.ChangePasswordMismatch : null;
    private async Task LoadAllAsync()
    {
        if (string.IsNullOrEmpty(_token)) return; _loading = true; _pageError = null;
        try { using var client = Client(); _certificates = await Get<List<Certificate>>(client,"api/v1/certificates") ?? []; _authorities = await Get<List<Authority>>(client,"api/v1/authorities") ?? []; _domains = await Get<List<Domain>>(client,"api/v1/domains") ?? []; _connectors = await Get<List<Connector>>(client,"api/v1/connector-instances") ?? []; _profiles = await Get<List<TargetProfileDto>>(client,"api/v1/profiles") ?? []; _plans = await Get<List<RenewalPlan>>(client,"api/v1/renewal-plans") ?? []; _issuers = await Get<List<ExternalIssuer>>(client,"api/v1/acme/external-issuers") ?? []; _acmeAccounts = await Get<List<AcmeAccountFull>>(client,"api/v1/acme/accounts") ?? []; _acmeOrders = await Get<List<AcmeOrderFull>>(client,"api/v1/acme/orders") ?? []; _rfc8555Accounts = await Get<List<Rfc8555AccountDto>>(client,"api/v1/acme/rfc8555-accounts") ?? []; _rfc8555Orders = await Get<List<Rfc8555OrderDto>>(client,"api/v1/acme/rfc8555-orders") ?? []; _externalCerts = await Get<List<ExternalAcmeCertDto>>(client,"api/v1/acme/external-certificates") ?? []; _warnings = await Get<List<ExpiryWarning>>(client,"api/v1/warnings/expiring") ?? []; _revocations = await Get<List<Revocation>>(client,"api/v1/revocations") ?? []; _sshCertificates = await Get<List<SshCertificateItem>>(client,"api/v1/ssh-certificates") ?? []; _backups = await Get<List<BackupListItem>>(client,"api/v1/backups") ?? []; SyncProfileSelection(); }
        catch { _pageError = "Die Verwaltungsdaten konnten nicht geladen werden. Prüfen Sie die Verbindung oder melden Sie sich erneut an."; }
        finally { _loading = false; await CheckForUpdateAsync(); }
    }
    private async Task<T?> Get<T>(HttpClient client, string path) { var response = await client.GetAsync(path); if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized) { Logout(); throw new InvalidOperationException(); } response.EnsureSuccessStatusCode(); return await response.Content.ReadFromJsonAsync<T>(_json); }
    private async Task Post(string path, object? body = null)
    {
        _busy = true;
        try { using var client = Client(); var response = body is null ? await client.PostAsync(path, null) : await client.PostAsJsonAsync(path, body); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response)); Snackbar.Add("Änderung wurde gespeichert.", Severity.Success); await LoadAllAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message == "Exception of type 'System.InvalidOperationException' was thrown." ? "Die Aktion konnte nicht abgeschlossen werden." : exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task InitializeAuthorities() => await Post("api/v1/authorities/initialize");
    private async Task SaveAuthority()
    {
        if (string.IsNullOrWhiteSpace(_authorityName) || string.IsNullOrWhiteSpace(_authoritySubject)) { Snackbar.Add("Name und Subject sind erforderlich.", Severity.Warning); return; }
        if (_authorityType == "intermediate" && string.IsNullOrWhiteSpace(_authorityParent)) { Snackbar.Add("Wählen Sie die übergeordnete Root-CA aus.", Severity.Warning); return; }
        if (_editingAuthorityId is null) { await Post("api/v1/authorities", new { name = _authorityName, subject = _authoritySubject, type = _authorityType, parentId = _authorityType == "root" ? null : _authorityParent, validityDays = _authorityValidityDays, keyAlgorithm = _authorityKeyAlgorithm, crlValidityDays = _authorityCrlValidityDays }); return; }
        _busy = true;
        try { using var client = Client(); var response = await client.PutAsJsonAsync($"api/v1/authorities/{Uri.EscapeDataString(_editingAuthorityId)}", new { name = _authorityName, isActive = _authorityActive, crlValidityDays = _authorityCrlValidityDays }); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response)); CancelAuthorityEdit(); Snackbar.Add("CA-Einstellungen gespeichert.", Severity.Success); await LoadAllAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private void BeginAuthorityEdit(Authority authority) { _editingAuthorityId = authority.Id; _authorityName = authority.Name; _authoritySubject = authority.Subject; _authorityType = authority.Type; _authorityParent = authority.ParentId ?? ""; _authorityCrlValidityDays = authority.CrlValidityDays; _authorityActive = authority.IsActive; }
    private void StartIntermediate() { CancelAuthorityEdit(); _authorityType = IntermediateAuthority; _authoritySubject = "CN=HomeCA TLS Issuing CA"; _authorityValidityDays = 1825; }
    private void CancelAuthorityEdit() { _editingAuthorityId = null; _authorityName = ""; _authoritySubject = "CN=HomeCA Root CA"; _authorityType = "root"; _authorityParent = ""; _authorityValidityDays = 3650; _authorityKeyAlgorithm = "ECC"; _authorityCrlValidityDays = 7; _authorityActive = true; }
    private async Task RevokeAuthority(string id) => await Post($"api/v1/authorities/{Uri.EscapeDataString(id)}/revoke");
    private async Task DeleteAuthority(string id)
    {
        if (_deleteAuthorityId != id) { _deleteAuthorityId = id; Snackbar.Add("Klicken Sie erneut auf Löschen, um die CA unwiderruflich zu entfernen.", Severity.Warning); return; }
        _busy = true;
        try { using var client = Client(); var response = await client.DeleteAsync($"api/v1/authorities/{Uri.EscapeDataString(id)}"); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response)); _deleteAuthorityId = null; Snackbar.Add("CA gelöscht.", Severity.Success); await LoadAllAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private static string AuthorityStatus(Authority authority) => authority.IsRevoked ? "Gesperrt" : authority.IsActive ? "Aktiv" : "Inaktiv";
    private async Task DeleteCertificate(string id)
    {
        if (_deleteCertificateId != id) { _deleteCertificateId = id; Snackbar.Add("Klicken Sie erneut, um das Zertifikat unwiderruflich zu widerrufen und zu löschen.", Severity.Warning); return; }
        _busy = true;
        try { using var client = Client(); var response = await client.DeleteAsync($"api/v1/certificates/{Uri.EscapeDataString(id)}?reason=cessationOfOperation"); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response)); _deleteCertificateId = null; Snackbar.Add("Zertifikat widerrufen und gelöscht. Die CRL wurde aktualisiert.", Severity.Success); await LoadAllAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task DownloadAuthority(string id, string format)
    {
        _busy = true;
        try
        {
            using var client = Client();
            var response = await client.GetAsync($"api/v1/authorities/{Uri.EscapeDataString(id)}/certificate?format={Uri.EscapeDataString(format)}");
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response));
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var name = response.Content.Headers.ContentDisposition?.FileNameStar ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? $"authority.{format}";
            await JS.InvokeVoidAsync("homeca.download", name, response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream", Convert.ToBase64String(bytes));
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task DownloadCertificateExport(string id, string format)
    {
        _busy = true;
        try
        {
            using var client = Client();
            var response = await client.GetAsync($"api/v1/certificates/{Uri.EscapeDataString(id)}/export/{Uri.EscapeDataString(format)}");
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response));
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var name = response.Content.Headers.ContentDisposition?.FileNameStar ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? $"{id}.{format}";
            await JS.InvokeVoidAsync("homeca.download", name, response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream", Convert.ToBase64String(bytes));
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task DownloadTrustAnchor(string format)
    {
        _busy = true;
        try
        {
            using var client = new HttpClient { BaseAddress = new Uri($"{Navigation.BaseUri}") };
            var response = await client.GetAsync($"api/v1/trust-anchor/{Uri.EscapeDataString(format)}");
