    protected override async Task OnInitializedAsync()
    {
        await RestoreBrowserSessionAsync();
        await LoadInstanceAsync();
        if (!string.IsNullOrEmpty(_token) && !_mustChangePassword)
        {
            await CheckSetupStateAsync();
            if (!_showSetupWizard) await LoadAllAsync();
        }
    }

    private async Task RestoreBrowserSessionAsync()
    {
        var sessionId = HttpContextAccessor.HttpContext?.Request.Cookies["HomeCA.UiSession"];
        if (!BrowserSessions.TryGetToken(sessionId, out var token)) return;
        var validation = await Administration.ValidateSessionAsync(token, CancellationToken.None);
        if (!validation.IsValid)
        {
            BrowserSessions.Remove(sessionId);
            return;
        }
        _token = token;
        _mustChangePassword = validation.MustChangePassword;
    }

    private HttpClient Client()
    {
        var client = InternalHttpClient.Create(new Uri(Navigation.BaseUri));
        if (!string.IsNullOrEmpty(_token)) client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _token);
        return client;
    }
    private async Task LoadInstanceAsync() { try { using var client = Client(); await client.GetFromJsonAsync<Instance>("api/v1/instance", _json); var phase = await client.GetFromJsonAsync<SetupPhaseDto>("api/v1/setup/phase", _json); _isFirstLogin = phase?.Phase == "initial"; } catch { } }
    private async Task LoginAsync()
    {
        await _loginForm!.Validate(); if (!_loginValid) return;
        _busy = true; _loginError = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/login", new { userName = _loginUser, password = _loginPassword });
            if (!response.IsSuccessStatusCode)
            {
                _loginError = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => Text["LoginInvalidCredentials"],
                    System.Net.HttpStatusCode.TooManyRequests => Text["LoginRateLimited"],
                    _ => Text["LoginHttpFailed", (int)response.StatusCode]
                };
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResult>(_json);
            _token = result?.AccessToken ?? throw new InvalidOperationException();
            _mustChangePassword = result.MustChangePassword;
            await JS.InvokeVoidAsync("homeca.persistBrowserSession", _token);
            if (!_mustChangePassword) { await CheckSetupStateAsync(); if (!_showSetupWizard) await LoadAllAsync(); }
        }
        catch (HttpRequestException) { _loginError = Text["LoginUnavailable"]; }
        catch { _loginError = Text["LoginProcessingFailed"]; }
        finally { _busy = false; }
    }
    // Click-twice, as the destructive actions do; the icon turns amber meanwhile.
    private async Task Logout()
    {
        if (!_confirmLogout) { _confirmLogout = true; Snackbar.Add(Text["ConfirmSignOut"], Severity.Warning); return; }
        await JS.InvokeVoidAsync("homeca.clearBrowserSession");
        _token = null; _loginPassword = null; _section = "overview"; _mustChangePassword = false; _currentPassword = ""; _newPassword = ""; _confirmPassword = ""; _changePasswordError = null; _changePasswordSuccess = null; _confirmLogout = false;
        ClearData(); Snackbar.Add(Text["SignedOut"], Severity.Info);
    }
    private void ClearData() { _certificates=[]; _authorities=[]; _domains=[]; _connectors=[]; _profiles=[]; _plans=[]; _issuers=[]; _warnings=[]; _revocations=[]; _rfc8555Accounts=[]; _rfc8555Orders=[]; _externalCerts=[]; _sshCertificates=[]; _selectedProfileId = ""; }
    private async Task ChangePasswordAsync()
    {
        await _changePasswordForm!.Validate(); if (!_changePasswordValid) return;
        if (_newPassword != _confirmPassword) { _changePasswordError = Text["ChangePasswordMismatch"]; return; }
        if (_newPassword.Length < 12) { _changePasswordError = Text["ChangePasswordTooShort"]; return; }
        _busy = true; _changePasswordError = null; _changePasswordSuccess = null;
        try
        {
            using var client = Client();
            var response = await client.PostAsJsonAsync("api/v1/change-password", new { currentPassword = _currentPassword, newPassword = _newPassword });
            if (!response.IsSuccessStatusCode) { _changePasswordError = Text["ChangePasswordError"]; return; }
            _changePasswordSuccess = Text["ChangePasswordSuccess"];
            await JS.InvokeVoidAsync("homeca.clearBrowserSession");
            _mustChangePassword = false; _token = null; _loginPassword = null; _currentPassword = ""; _newPassword = ""; _confirmPassword = "";
        }
        catch { _changePasswordError = Text["ChangePasswordError"]; }
        finally { _busy = false; }
    }
    private string? ValidateNewPassword(string value) => !string.IsNullOrEmpty(value) && value.Length < 12 ? Text["ChangePasswordTooShort"].Value : null;
    private string? ValidateConfirmPassword(string value) => !string.IsNullOrEmpty(value) && value != _newPassword ? Text["ChangePasswordMismatch"].Value : null;
    private async Task LoadAllAsync()
