            <MudFileUpload T="IBrowserFile" Accept=".key" FilesChanged="UploadBackupKey" Class="d-inline-flex ml-2" MaximumFileCount="1"><ActivatorContent><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy" StartIcon="@Icons.Material.Filled.Upload">@Text["UploadKey"]</MudButton></ActivatorContent></MudFileUpload>
        </MudPaper>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h6">@Text["EncryptedBackup"]</MudText><MudText Class="mb-3">@Text["EncryptedBackupDescription"]</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="CreateBackup" StartIcon="@Icons.Material.Filled.AddCircle">@Text["CreateBackup"]</MudButton>
            <MudFileUpload T="IBrowserFile" Accept=".hcab" FilesChanged="UploadBackup" Class="d-inline-flex ml-2" MaximumFileCount="1"><ActivatorContent><MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy" StartIcon="@Icons.Material.Filled.Upload">@Text["UploadBackup"]</MudButton></ActivatorContent></MudFileUpload>
            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="LoadBackupList" StartIcon="@Icons.Material.Filled.Refresh" Class="ml-2">@Text["Refresh"]</MudButton>
