    private RenderFragment OverviewContent => @<text>
        <MudText Typo="Typo.overline" Class="section-kicker">@Text["OverviewKicker"]</MudText><MudText Typo="Typo.h3" Class="page-title">@Text["OverviewTitle"]</MudText>
        <div class="metric-grid"><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@Text["MetricCertificates"]</MudText><MudText Typo="Typo.h3">@_certificates.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@Text["MetricCAs"]</MudText><MudText Typo="Typo.h3">@_authorities.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">@Text["MetricRenewals"]</MudText><MudText Typo="Typo.h3">@_plans.Count(p => p.Enabled)</MudText></MudPaper></div>
        @if (_warnings.Count > 0) { <MudAlert Severity="Severity.Warning" Class="mb-4"><b>@Text["ExpiryWarning", _warnings.Count]</b><br />@string.Join(" · ", _warnings.Select(w => $"{w.Subject} ({Text["ExpiryDays", w.DaysRemaining]})"))</MudAlert> }
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["TrustAnchorTitle"]</MudText><MudText Class="mud-text-secondary mb-3">@Text["TrustAnchorDescription"]</MudText><div class="d-flex gap-2 flex-wrap"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadTrustAnchor("pem"))">@Text["TrustAnchorPem"]</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => DownloadTrustAnchor("der"))">@Text["TrustAnchorDer"]</MudButton></div></MudPaper>
        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@Text["LatestCertificates"]</MudText>@CertificateTable(_certificates.Take(5))</MudPaper>
    </text>;

    private RenderFragment CertificatesContent => @<text>
