    {
        if (_deleteRfc8555AccountId != id) { _deleteRfc8555AccountId = id; Snackbar.Add(Text["ConfirmRfc8555AccountDelete"], Severity.Warning); return; }
        _busy = true;
        try { using var client = Client(); var response = await client.DeleteAsync($"api/v1/acme/rfc8555-accounts/{Uri.EscapeDataString(id)}"); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await ReadApiError(response)); _deleteRfc8555AccountId = null; Snackbar.Add(Text["Rfc8555AccountDeleted"], Severity.Success); await LoadAllAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }
