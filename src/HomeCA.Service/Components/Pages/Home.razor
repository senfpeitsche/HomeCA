                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => VerifyBackupByName(context.FileName))">@Text["Verify"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBackup(context.FileName))">@(_deleteBackupFileName == context.FileName ? Text["ConfirmDelete"] : Text["Delete"])</MudButton>
