        <MudText Typo="Typo.overline" Class="section-kicker">@L.AcmeKicker</MudText><MudText Typo="Typo.h3" Class="page-title">@L.AcmeTitle</MudText>
        <div class="metric-grid"><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">RFC 8555-Konten</MudText><MudText Typo="Typo.h3">@_rfc8555Accounts.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">RFC 8555-Aufträge</MudText><MudText Typo="Typo.h3">@_rfc8555Orders.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">Externe Aussteller</MudText><MudText Typo="Typo.h3">@_issuers.Count</MudText></MudPaper><MudPaper Class="metric-card" Elevation="0"><MudText Typo="Typo.overline">Externe Zertifikate</MudText><MudText Typo="Typo.h3">@_externalCerts.Count</MudText></MudPaper></div>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeRfc8555Accounts</MudText><MudText Class="mud-text-secondary mb-3">Konten, die über Standard-ACME-Clients (OPNsense, acme.sh, Certbot) registriert wurden.</MudText><MudTable Items="_rfc8555Accounts" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@L.AcmeColumnContact</MudTh><MudTh>@L.AcmeColumnThumbprint</MudTh><MudTh>@L.AcmeColumnStatus</MudTh><MudTh>@L.AcmeColumnCreated</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(8, context.Id.Length)]…</MudText></MudTd><MudTd>@(context.Contact.Length > 0 ? string.Join(", ", context.Contact) : "—")</MudTd><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Thumbprint[..Math.Min(12, context.Thumbprint.Length)]…</MudText></MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == "valid" ? Color.Success : Color.Default)">@context.Status</MudChip></MudTd><MudTd>@Date(context.CreatedAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteRfc8555Account(context.Id))">@(_deleteRfc8555AccountId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@L.AcmeNoAccounts</MudText></NoRecordsContent></MudTable></MudPaper>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeRfc8555Orders</MudText><MudTable Items="_rfc8555Orders" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@L.AcmeColumnIdentifiers</MudTh><MudTh>@L.AcmeColumnStatus</MudTh><MudTh>@L.AcmeColumnCertificate</MudTh><MudTh>@L.AcmeColumnCreated</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(8, context.Id.Length)]…</MudText></MudTd><MudTd>@string.Join(", ", context.Identifiers.Select(i => i.Value))</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == "valid" ? Color.Success : context.Status == "ready" ? Color.Info : Color.Default)">@context.Status</MudChip></MudTd><MudTd>@(context.CertificateId is not null ? context.CertificateId[..Math.Min(8, context.CertificateId.Length)] + "…" : "—")</MudTd><MudTd>@Date(context.CreatedAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteRfc8555Order(context.Id))">@(_deleteRfc8555OrderId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@L.AcmeNoOrders</MudText></NoRecordsContent></MudTable></MudPaper>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeExternalIssuers</MudText><MudTable Items="_issuers" Dense="true" Hover="true"><HeaderContent><MudTh>Name</MudTh><MudTh>Directory-URL</MudTh><MudTh>DNS-Connector</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd><MudText Typo="Typo.caption">@context.DirectoryUrl</MudText></MudTd><MudTd>@ConnectorName(context.ConnectorId)</MudTd><MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => BeginIssuerEdit(context))">Bearbeiten</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteIssuer(context.Id))">@(_deleteIssuerId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">Noch keine externen ACME-Issuer registriert.</MudText></NoRecordsContent></MudTable></MudPaper>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeExternalCertificates</MudText><MudTable Items="_externalCerts" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>DNS-Namen</MudTh><MudTh>Aussteller</MudTh><MudTh>Erstellt</MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(8, context.Id.Length)]…</MudText></MudTd><MudTd>@string.Join(", ", context.DnsNames)</MudTd><MudTd>@context.IssuerName</MudTd><MudTd>@Date(context.CreatedAt)</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@L.AcmeNoExternalCerts</MudText></NoRecordsContent></MudTable></MudPaper>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeSimplifiedAccounts</MudText><MudText Class="mud-text-secondary mb-3">Konten, die über die vereinfachte JSON-API (curl/Skripte) registriert wurden.</MudText><MudTable Items="_acmeAccounts" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@L.AcmeColumnContact</MudTh><MudTh>@L.AcmeColumnCreated</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(8, context.Id.Length)]…</MudText></MudTd><MudTd>@context.Contact</MudTd><MudTd>@Date(context.CreatedAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAcmeAccount(context.Id))">@(_deleteAcmeAccountId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@L.AcmeNoAccounts</MudText></NoRecordsContent></MudTable></MudPaper>

        <MudPaper Class="panel" Elevation="0"><MudText Typo="Typo.h5">@L.AcmeSimplifiedOrders</MudText><MudTable Items="_acmeOrders" Dense="true" Hover="true"><HeaderContent><MudTh>ID</MudTh><MudTh>@L.AcmeColumnIdentifiers</MudTh><MudTh>@L.AcmeColumnStatus</MudTh><MudTh>@L.AcmeColumnCertificate</MudTh><MudTh>@L.AcmeColumnCreated</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><MudText Typo="Typo.caption" Style="font-family:monospace">@context.Id[..Math.Min(8, context.Id.Length)]…</MudText></MudTd><MudTd>@string.Join(", ", context.Identifiers)</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == "valid" ? Color.Success : context.Status == "ready" ? Color.Info : Color.Default)">@context.Status</MudChip></MudTd><MudTd>@(context.CertificateId ?? "—")</MudTd><MudTd>@Date(context.CreatedAt)</MudTd><MudTd><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAcmeOrder(context.Id))">@(_deleteAcmeOrderId == context.Id ? "Löschen bestätigen" : "Löschen")</MudButton></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@L.AcmeNoOrders</MudText></NoRecordsContent></MudTable></MudPaper>
    </text>;

    private record LoginResult(string AccessToken, bool MustChangePassword); private record Instance(bool IsInitialized); private record Certificate(string Id,string Subject,DateTime ValidFrom,DateTime ExpiresAt,string KeyAlgorithm,string ExportPath); private record CertificateDetailsDto(string Id,string Subject,string Issuer,string SerialNumber,string Sha256Fingerprint,DateTime ValidFrom,DateTime ExpiresAt,string KeyAlgorithm,int KeySize,string Usage,List<string> DnsNames,List<string> IpAddresses,List<string> EnhancedKeyUsages,string ExportPath); private record Authority(string Id,string Name,string Type,string Subject,DateTime ExpiresAt,string? ParentId,bool IsActive,bool IsRevoked,int CrlValidityDays); private record Domain(string Name,bool InternalIssuanceEnabled,string? ConnectorId,DateTimeOffset CreatedAt); private record Connector(string Id,string Name,string Type,DateTimeOffset CreatedAt); private sealed class TargetProfileDto { public string Id { get; set; } = ""; public string Version { get; set; } = ""; public string DisplayName { get; set; } = ""; public string Purpose { get; set; } = ""; public string KeyAlgorithm { get; set; } = ""; public List<string> ExportFormats { get; set; } = []; public ProfileValidationDto? Validation { get; set; } = new(); public string Documentation { get; set; } = ""; public string RenewalScriptTemplate { get; set; } = ""; } private sealed class ProfileValidationDto { public bool RequiresDnsName { get; set; } public bool AllowsIpAddress { get; set; } = true; public int MaximumValidityDays { get; set; } = 730; } private record RenewalPlan(string Id,string CertificateId,int RenewBeforeDays,bool Enabled,DateTimeOffset CreatedAt); private record ExternalIssuer(string Id,string Name,string DirectoryUrl,string ConnectorId,DateTimeOffset CreatedAt); private record ExpiryWarning(string Subject,DateTime ExpiresAt,int DaysRemaining); private record Revocation(string SerialNumber,string Reason,DateTimeOffset RevokedAt); private record AcmeAccount(string Id); private record AcmeOrder(string Id); private record AcmeAccountFull(string Id,string Contact,DateTimeOffset CreatedAt); private record AcmeOrderFull(string Id,string AccountId,IReadOnlyList<string> Identifiers,string Status,DateTimeOffset CreatedAt,string? CertificateId); private record Rfc8555AccountDto(string Id,string Thumbprint,string[] Contact,string Status,DateTimeOffset CreatedAt); private record Rfc8555IdentifierDto(string Type,string Value); private record Rfc8555OrderDto(string Id,string AccountId,IReadOnlyList<Rfc8555IdentifierDto> Identifiers,string Status,DateTimeOffset CreatedAt,DateTimeOffset Expires,string? CertificateId); private record ExternalAcmeCertDto(string Id,IReadOnlyList<string> DnsNames,string IssuerName,DateTimeOffset CreatedAt); private record Backup(string FileName); private record BackupListItem(string FileName, long Size, DateTimeOffset CreatedAt); private record UpdateCheckDto(string CurrentVersion, string? LatestVersion, bool UpdateAvailable, string? ReleaseUrl); private record ConnectorCheckResult(bool Connected, List<string> Zones, string? Message); private record ApiProblem(string? Detail, Dictionary<string, string[]>? Errors); private record SshIssueResultDto(string Id, string Authority, string CertificatePath, string Certificate); private record SshCertificateItem(string Id, string Kind, string Identity, string Principals, DateTime IssuedAt, string? ValidUntil); private record SshCaKeyDto(string Authority, string PublicKey);
}
