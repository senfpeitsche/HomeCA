@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text

<MudText Typo="Typo.overline" Class="section-kicker">@Text["HelpKicker"]</MudText>
<MudText Typo="Typo.h3" Class="page-title">@Text["HelpTitle"]</MudText>
<MudText Class="mud-text-secondary mb-4">@Text["HelpDescription"]</MudText>

<MudPaper Class="panel" Elevation="0">
    <MudTabs Rounded="false" PanelClass="pt-4">
        <MudTabPanel Text="@Text["HelpTabTls"]"><LocalizedHelp Topic="tls" /></MudTabPanel>
        <MudTabPanel Text="@Text["HelpTabSsh"]"><LocalizedHelp Topic="ssh" /></MudTabPanel>
        <MudTabPanel Text="@Text["HelpTabTrust"]"><LocalizedHelp Topic="trust" /></MudTabPanel>
        <MudTabPanel Text="@Text["HelpTabAcme"]"><LocalizedHelp Topic="acme" /></MudTabPanel>
        <MudTabPanel Text="@Text["HelpTabCaRotation"]"><LocalizedHelp Topic="ca-rotation" /></MudTabPanel>
    </MudTabs>
</MudPaper>
