@inject UiStrings L

<MudText Typo="Typo.overline" Class="section-kicker">@L.HelpKicker</MudText>
<MudText Typo="Typo.h3" Class="page-title">@L.HelpTitle</MudText>
<MudText Class="mud-text-secondary mb-4">@L.HelpDescription</MudText>

<MudPaper Class="panel" Elevation="0">
    <MudTabs Rounded="false" PanelClass="pt-4" @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="@L.HelpTabTls">
            @TlsHelp
        </MudTabPanel>
        <MudTabPanel Text="@L.HelpTabSsh">
            @SshHelp
        </MudTabPanel>
        <MudTabPanel Text="@L.HelpTabTrust">
            @TrustHelp
        </MudTabPanel>
        <MudTabPanel Text="@L.HelpTabAcme">
            @AcmeHelp
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private int _activeTab;

    // ── TLS-Zertifikate ──────────────────────────────────────────────────────
    private RenderFragment TlsHelp => @<div class="help-content">
        <MudText Typo="Typo.h4" Class="mt-2 mb-3">TLS-Zertifikate ausstellen und einsetzen</MudText>
        <MudText Class="mud-text-secondary mb-4">Diese Anleitung beschreibt, wie du mit HomeCA TLS- und mTLS-Zertifikate für interne Dienste ausstellst, auf Zielsysteme überträgst und die automatische Erneuerung einrichtest.</MudText>

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Voraussetzungen</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Check">HomeCA läuft und <code>/health</code> antwortet erfolgreich.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Root- und Issuing-CA sind initialisiert (Zertifizierungsstellen > „CA erstellen").</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Das Root-CA-Zertifikat ist auf den Clients installiert — siehe Tab „Vertrauensstellung".</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check"><code>PublicUrl</code> ist in <code>appsettings.json</code> konfiguriert, damit CRL-Verteilungspunkte in die Zertifikate eingebettet werden.</MudListItem>
        </MudList>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">1. Zertifikat über die Weboberfläche ausstellen</MudText>
        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Schritt 1 — Zielprofil wählen</MudText>
        <MudText>Öffne den Bereich <strong>Zertifikate</strong> und wähle im Tab „TLS- und mTLS-Zertifikat" ein Zielprofil aus der Dropdown-Liste. Das Profil setzt Standardwerte für Schlüsselalgorithmus, maximale Laufzeit, Exportformate und IP-SAN-Unterstützung.</MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Profil</th><th>Algorithmus</th><th>Exportformate</th><th>Besonderheiten</th></tr></thead>
            <tbody>
                <tr><td>Generisches TLS</td><td>ECC</td><td>PEM, PFX</td><td>Universell einsetzbar</td></tr>
                <tr><td>Windows IIS</td><td>RSA</td><td>PFX</td><td>Für IIS-Bindung und RDP</td></tr>
                <tr><td>Proxmox VE</td><td>ECC</td><td>PEM</td><td>Kein IP-SAN</td></tr>
                <tr><td>OPNsense</td><td>RSA</td><td>PFX, PEM</td><td>Firewall-Weboberfläche</td></tr>
                <tr><td>Home Assistant</td><td>ECC</td><td>PEM</td><td>Kein IP-SAN</td></tr>
                <tr><td>UniFi OS</td><td>ECC</td><td>PEM</td><td>Kein IP-SAN</td></tr>
                <tr><td>HAProxy</td><td>ECC</td><td>PEM</td><td>Bundle-Export (Key+Cert+Chain)</td></tr>
                <tr><td>nginx</td><td>ECC</td><td>PEM</td><td>Fullchain für <code>ssl_certificate</code></td></tr>
                <tr><td>Cisco Switch</td><td>RSA</td><td>PEM, PFX</td><td>PKCS12-Import per CLI</td></tr>
                <tr><td>Huawei Switch</td><td>RSA</td><td>PEM, PFX</td><td>VRP-spezifischer Import</td></tr>
                <tr><td>Synology DSM</td><td>RSA</td><td>PEM</td><td>Kein IP-SAN</td></tr>
                <tr><td>TeamCity</td><td>RSA</td><td>PFX, PEM</td><td>Java-Keystore oder Reverse Proxy</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Schritt 2 — Zertifikat definieren</MudText>
        <MudList T="string" Dense="true">
            <MudListItem><strong>Verwendung:</strong> <code>TLS-Server</code> für normale Serverzertifikate oder <code>mTLS / Client</code> für gegenseitige Authentifizierung.</MudListItem>
            <MudListItem><strong>DNS-Namen:</strong> Kommagetrennt, z. B. <code>app.home.lab, api.home.lab</code>. Wildcards werden unterstützt (<code>*.home.lab</code>).</MudListItem>
            <MudListItem><strong>IP-Adressen:</strong> Optional und kommagetrennt. Nicht bei allen Profilen verfügbar.</MudListItem>
            <MudListItem><strong>Gültigkeit:</strong> 1 bis maximal 730 Tage, abhängig vom Profil.</MudListItem>
            <MudListItem><strong>Schlüsselalgorithmus:</strong> ECC (P-256) oder RSA. Einige Profile erzwingen RSA.</MudListItem>
        </MudList>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Schritt 3 — Ausstellen und herunterladen</MudText>
        <MudText>Klicke auf den Ausstellungsbutton. HomeCA erzeugt das Zertifikat, signiert es mit der Issuing CA und erstellt ein Deployment-Paket.</MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Export</th><th>Inhalt</th><th>Typischer Einsatz</th></tr></thead>
            <tbody>
                <tr><td>PEM</td><td>Serverzertifikat</td><td>Standardformat für Linux-Dienste</td></tr>
                <tr><td>Key</td><td>Privater Schlüssel (PKCS#8)</td><td>Immer zusammen mit PEM verwenden</td></tr>
                <tr><td>Chain</td><td>Issuing-CA + Root-CA</td><td>Dienste, die die Kette separat brauchen</td></tr>
                <tr><td>Fullchain</td><td>Zertifikat + Chain</td><td>nginx <code>ssl_certificate</code>, Apache</td></tr>
                <tr><td>Bundle</td><td>Key + Zertifikat + Chain</td><td>HAProxy <code>crt</code>-Datei</td></tr>
                <tr><td>PFX</td><td>PKCS#12-Archiv mit Kennwort</td><td>Windows, Java-Keystores, Cisco</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">2. Zertifikat über die API ausstellen</MudText>
        <CodePreview Text="@_tlsApiIssue" Lines="8" />
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Parameter</th><th>Pflicht</th><th>Standard</th><th>Erklärung</th></tr></thead>
            <tbody>
                <tr><td><code>usage</code></td><td>Ja</td><td>—</td><td><code>TLS</code> oder <code>mTLS</code></td></tr>
                <tr><td><code>dnsNames</code></td><td>Ja*</td><td>—</td><td>Liste von DNS-Namen</td></tr>
                <tr><td><code>ipAddresses</code></td><td>Nein</td><td><code>[]</code></td><td>Liste von IP-Adressen</td></tr>
                <tr><td><code>validityDays</code></td><td>Nein</td><td><code>365</code></td><td>1 bis 730 Tage</td></tr>
                <tr><td><code>keyAlgorithm</code></td><td>Nein</td><td><code>ECC</code></td><td><code>ECC</code> (P-256) oder <code>RSA</code></td></tr>
                <tr><td><code>rsaKeySize</code></td><td>Nein</td><td><code>2048</code></td><td>Nur bei RSA: <code>2048</code> oder <code>3072</code></td></tr>
                <tr><td><code>targetProfileId</code></td><td>Nein</td><td><code>generic-tls</code></td><td>Profilbezogenes Deployment-Paket</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Exportdateien herunterladen</MudText>
        <CodePreview Text="@_tlsApiExports" Lines="10" />

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">3. Zertifikate auf Zielsysteme einspielen</MudText>
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Text="Proxmox VE">
                <CodePreview Text="@_tlsDeployProxmox" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="nginx">
                <CodePreview Text="@_tlsDeployNginx" Lines="8" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="HAProxy">
                <CodePreview Text="@_tlsDeployHaproxy" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Windows IIS">
                <CodePreview Text="@_tlsDeployIis" Lines="6" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Windows RDP">
                <CodePreview Text="@_tlsDeployRdp" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="OPNsense">
                <MudText Class="pa-2">System > Trust > Certificates > Hinzufügen — Method: „Import an existing Certificate" — Zertifikat (PEM) und privaten Schlüssel einfügen — Speichern, dann unter System > Settings > Administration als Web-GUI-Zertifikat auswählen.</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Home Assistant">
                <CodePreview Text="@_tlsDeployHomeAssistant" Lines="5" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="UniFi OS">
                <MudText Class="pa-2">Einstellungen > System > Erweitert > TLS-Zertifikat hochladen (<code>certificate.pem</code> und <code>key.pem</code>).</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-2">Selbst gehosteter Controller:</MudText>
                <CodePreview Text="@_tlsDeployUnifi" Lines="5" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Synology DSM">
                <MudText Class="pa-2">DSM > Systemsteuerung > Sicherheit > Zertifikat > Hinzufügen > Vorhandenes Zertifikat importieren: Zertifikat (<code>certificate.pem</code>), Privater Schlüssel (<code>key.pem</code>), Zwischenzertifikat (<code>chain.pem</code>).</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Cisco IOS/IOS-XE">
                <CodePreview Text="@_tlsDeployCisco" Lines="5" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="TeamCity">
                <CodePreview Text="@_tlsDeployTeamCity" Lines="4" />
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">4. Automatische Erneuerung</MudText>
        <MudText>Navigiere zu <strong>Automatik</strong> in der Seitenleiste. Wähle ein Zertifikat, setze die Anzahl Tage vor Ablauf (Standard: 30) und aktiviere den Plan. Der Hintergrunddienst prüft stündlich alle aktiven Pläne und stellt das Zertifikat automatisch mit denselben SANs, demselben Algorithmus und derselben Laufzeit neu aus.</MudText>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Erneuerungsplan per API</MudText>
        <CodePreview Text="@_tlsApiRenewal" Lines="7" />

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">5. Zertifikat sperren</MudText>
        <MudText>Im Zertifikatsinventar auf <strong>Widerrufen</strong> klicken. Das Zertifikat wird automatisch in die Sperrliste aufgenommen und die CRL neu generiert.</MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-2">Per API:</MudText>
        <CodePreview Text="@_tlsApiRevoke" Lines="2" />

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">6. Ablaufwarnungen überwachen</MudText>
        <MudText><code>GET /api/v1/warnings/expiring</code> liefert alle Zertifikate, die innerhalb von 30 Tagen ablaufen. Die Weboberfläche zeigt Ablaufwarnungen auf der Übersichtsseite als orangefarbene Meldung an.</MudText>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">7. Typischer Ablauf von Anfang bis Ende</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.LooksOne">HomeCA installieren und starten</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.LooksTwo">Administrator einrichten — Setup-Endpunkt vom Loopback-Host</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Looks3">CAs initialisieren — Root-CA und Issuing-CA anlegen</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Looks4">Root-CA verteilen — siehe Tab „Vertrauensstellung"</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Looks5">Zertifikat ausstellen — Profil wählen, DNS-Namen eingeben</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Looks6">Exportdateien auf Zielsystem übertragen</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Erneuerungsplan anlegen und Monitoring einrichten</MudListItem>
        </MudList>
    </div>;

    // ── SSH-Zertifikate ──────────────────────────────────────────────────────
    private RenderFragment SshHelp => @<div class="help-content">
        <MudText Typo="Typo.h4" Class="mt-2 mb-3">SSH-Zertifikate ausstellen und einsetzen</MudText>
        <MudText Class="mud-text-secondary mb-4">SSH-Zertifikate ersetzen das manuelle Schlüsselmanagement durch eine zentrale Vertrauenshierarchie. HomeCA betreibt zwei getrennte SSH-CAs: eine für Host-Keys und eine für Benutzerschlüssel.</MudText>

        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Problem</th><th>Lösung mit SSH-Zertifikaten</th></tr></thead>
            <tbody>
                <tr><td>Fingerprint-Abfrage bei jedem neuen Server</td><td>Clients vertrauen der Host-CA — signierte Host-Keys werden automatisch akzeptiert</td></tr>
                <tr><td><code>authorized_keys</code> auf jedem Server pflegen</td><td>Server vertrauen der User-CA — signierte Benutzerschlüssel werden automatisch akzeptiert</td></tr>
                <tr><td>Kein Ablaufdatum für SSH-Keys</td><td>Zertifikate haben eine konfigurierbare Gültigkeitsdauer</td></tr>
                <tr><td>Kein zentrales Inventar</td><td>HomeCA stellt Zertifikate zentral aus und protokolliert die Ausstellung</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">Voraussetzungen</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Check">HomeCA läuft und <code>/health</code> antwortet erfolgreich.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Root- und Issuing-CA sind initialisiert (SSH-CA-Schlüsselpaare werden automatisch erzeugt).</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check"><code>openssh-client</code> ist auf dem HomeCA-Host installiert (für <code>ssh-keygen</code>).</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Zielsysteme haben OpenSSH 5.4 oder neuer.</MudListItem>
        </MudList>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">1. SSH-Zertifikat über die Weboberfläche ausstellen</MudText>
        <MudText>Öffne den Bereich <strong>Zertifikate</strong> und wechsle zum Tab <strong>SSH-Zertifikat</strong>.</MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Feld</th><th>Erklärung</th><th>Beispiel</th></tr></thead>
            <tbody>
                <tr><td>Art</td><td><code>Host</code> für Server-Host-Keys, <code>Benutzer</code> für persönliche Schlüssel</td><td><code>Host</code></td></tr>
                <tr><td>Identität</td><td>Frei wählbarer Name (Key-ID im Zertifikat)</td><td><code>webserver.home.lab</code></td></tr>
                <tr><td>Principals</td><td>Kommagetrennte Liste gültiger Hostnamen oder Benutzernamen</td><td><code>webserver.home.lab, webserver</code></td></tr>
                <tr><td>Öffentlicher SSH-Schlüssel</td><td>Public Key im OpenSSH-Format (Inhalt von <code>*.pub</code>)</td><td><code>ssh-ed25519 AAAA...</code></td></tr>
                <tr><td>Gültigkeit in Tagen</td><td>1 bis 3650 (Standard: 365)</td><td><code>365</code></td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Principals richtig wählen</MudText>
        <MudText><strong>Host-Zertifikate:</strong> Alle relevanten Hostnamen und FQDNs eintragen, z. B. <code>webserver, webserver.home.lab, 192.168.1.50</code>.</MudText>
        <MudText><strong>Benutzerzertifikate:</strong> Die Unix-Benutzernamen, als die sich der Benutzer anmelden darf, z. B. <code>root, deploy, admin</code>.</MudText>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">2. SSH-Zertifikat über die API ausstellen</MudText>
        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Host-Zertifikat</MudText>
        <CodePreview Text="@_sshApiHost" Lines="9" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Benutzerzertifikat</MudText>
        <CodePreview Text="@_sshApiUser" Lines="9" />

        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Parameter</th><th>Pflicht</th><th>Standard</th><th>Erklärung</th></tr></thead>
            <tbody>
                <tr><td><code>kind</code></td><td>Ja</td><td>—</td><td><code>host</code> oder <code>user</code></td></tr>
                <tr><td><code>identity</code></td><td>Ja</td><td>—</td><td>Key-ID — frei wählbarer Bezeichner</td></tr>
                <tr><td><code>principals</code></td><td>Ja</td><td>—</td><td>Liste gültiger Hostnamen (Host) oder Benutzernamen (User)</td></tr>
                <tr><td><code>publicKey</code></td><td>Ja</td><td>—</td><td>Öffentlicher SSH-Schlüssel im OpenSSH-Format</td></tr>
                <tr><td><code>validityDays</code></td><td>Nein</td><td><code>365</code></td><td>Gültigkeitsdauer in Tagen (1–3650)</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">3. Vertrauensstellung einrichten</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Die CA-Public-Keys sind in der Weboberfläche unter <strong>Zertifizierungsstellen</strong> als Download verfügbar, oder per API unter <code>/api/v1/ssh-ca-keys/host</code> und <code>/api/v1/ssh-ca-keys/user</code>.</MudAlert>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">Host-CA auf Clients einrichten (keine Fingerprint-Warnungen mehr)</MudText>
        <CodePreview Text="@_sshTrustHost" Lines="5" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">User-CA auf Servern einrichten (kein authorized_keys mehr nötig)</MudText>
        <CodePreview Text="@_sshTrustUser" Lines="7" />

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">4. Zertifikate auf Zielsystemen einspielen</MudText>
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Text="Host-Zertifikat auf einem Server installieren">
                <CodePreview Text="@_sshDeployHost" Lines="7" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Benutzerzertifikat verwenden">
                <CodePreview Text="@_sshDeployUser" Lines="4" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Principals einschränken (empfohlen)">
                <CodePreview Text="@_sshPrincipals" Lines="10" />
            </MudExpansionPanel>
        </MudExpansionPanels>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">5. Empfohlene Gültigkeitsdauern</MudText>
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Zertifikatstyp</th><th>Empfehlung</th><th>Begründung</th></tr></thead>
            <tbody>
                <tr><td>Host-Zertifikat</td><td>365 Tage</td><td>Server sind stabil, seltene Erneuerung ausreichend</td></tr>
                <tr><td>Benutzerzertifikat</td><td>1–90 Tage</td><td>Kürzere Laufzeit begrenzt das Risiko bei Schlüsselverlust</td></tr>
                <tr><td>Benutzerzertifikat (CI/CD)</td><td>1–7 Tage</td><td>Kurzlebig für automatisierte Deployments</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">6. Fehlerbehebung</MudText>
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Text="'Permission denied (publickey)' trotz Zertifikat">
                <MudList T="string" Dense="true">
                    <MudListItem>Zertifikat liegt neben dem Schlüssel und ist korrekt benannt (<code>id_ed25519</code> erwartet <code>id_ed25519-cert.pub</code>).</MudListItem>
                    <MudListItem>Principal im Zertifikat stimmt mit dem Unix-Benutzernamen überein.</MudListItem>
                    <MudListItem><code>TrustedUserCAKeys</code> zeigt auf den richtigen Pfad.</MudListItem>
                    <MudListItem>Verbose-Output prüfen: <code>ssh -vvv user@@server</code></MudListItem>
                </MudList>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Host-Key-Warnung trotz Host-Zertifikat">
                <MudList T="string" Dense="true">
                    <MudListItem><code>@@cert-authority</code>-Eintrag in <code>known_hosts</code> passt zum Hostnamen.</MudListItem>
                    <MudListItem>Server liefert das Zertifikat aus: <code>ssh-keyscan -c webserver.home.lab</code></MudListItem>
                    <MudListItem>Veraltete Fingerprint-Einträge für den Host entfernen.</MudListItem>
                </MudList>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>;

    // ── Vertrauensstellung ───────────────────────────────────────────────────
    private RenderFragment TrustHelp => @<div class="help-content">
        <MudText Typo="Typo.h4" Class="mt-2 mb-3">Root-CA-Vertrauensstellung einrichten</MudText>
        <MudText Class="mud-text-secondary mb-4">Damit Geräte und Browser den von HomeCA ausgestellten Zertifikaten vertrauen, muss das Root-CA-Zertifikat im jeweiligen Vertrauensspeicher installiert werden.</MudText>

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Root-CA-Zertifikat herunterladen</MudText>
        <MudText>HomeCA stellt das Root-CA-Zertifikat ohne Authentifizierung bereit:</MudText>
        <CodePreview Text="@_trustDownload" Lines="5" />
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Prüfe den SHA-256-Fingerprint immer gegen die Ausgabe des <code>/api/v1/trust-anchor</code>-Endpunkts, bevor du das Zertifikat installierst.</MudAlert>

        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Text="Windows">
                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Einzelner Rechner (als Administrator)</MudText>
                <CodePreview Text="@_trustWindows" Lines="1" />
                <MudText Class="mt-2">Alternativ: Doppelklick auf die <code>.cer</code>-Datei > „Zertifikat installieren" > Lokaler Computer > Vertrauenswürdige Stammzertifizierungsstellen.</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Per Gruppenrichtlinie (Active Directory)</MudText>
                <MudText>Computerkonfiguration > Windows-Einstellungen > Sicherheitseinstellungen > Richtlinien öffentlicher Schlüssel > Vertrauenswürdige Stammzertifizierungsstellen > Importieren.</MudText>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Linux (Debian/Ubuntu)">
                <CodePreview Text="@_trustLinux" Lines="2" />
                <MudText Class="mt-2">Hinweis: Die Datei muss die Endung <code>.crt</code> haben, auch wenn es PEM-Format ist.</MudText>
            </MudExpansionPanel>

            <MudExpansionPanel Text="macOS">
                <CodePreview Text="@_trustMacOs" Lines="1" />
                <MudText Class="mt-2">Alternativ: Doppelklick auf die <code>.pem</code>-Datei > Schlüsselbundverwaltung > System > Doppelklick > Vertrauen > „Immer vertrauen".</MudText>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Firefox">
                <MudText Class="pa-2"><strong>Manuell:</strong> Einstellungen > Datenschutz & Sicherheit > Zertifikate > Zertifikate anzeigen > Zertifizierungsstellen > Importieren > „Dieser CA vertrauen, um Websites zu identifizieren" aktivieren.</MudText>
                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Per Richtlinie (Enterprise)</MudText>
                <CodePreview Text="@_trustFirefox" Lines="7" />
            </MudExpansionPanel>

            <MudExpansionPanel Text="OPNsense">
                <MudText Class="pa-2">System > Trust > Authorities > Hinzufügen > Method: „Import an existing Certificate Authority" > PEM-Inhalt einfügen > Speichern.</MudText>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Netzwerk-Switches (Cisco, Huawei)">
                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Cisco IOS/IOS-XE</MudText>
                <CodePreview Text="@_trustCisco" Lines="5" />
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Huawei VRP</MudText>
                <CodePreview Text="@_trustHuawei" />
            </MudExpansionPanel>

            <MudExpansionPanel Text="Android">
                <MudText Class="pa-2">Einstellungen > Sicherheit > Verschlüsselung und Anmeldedaten > Zertifikate installieren > CA-Zertifikat > <code>.cer</code>-Datei auswählen.</MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Ab Android 7 vertrauen Apps standardmäßig nur System-CAs. Benutzerdefinierte CAs gelten nur für den Browser.</MudAlert>
