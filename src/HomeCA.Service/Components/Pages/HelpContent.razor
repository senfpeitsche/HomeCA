    private const string _acmeDirectory = "curl -s http://HOMECA:5080/api/v1/acme/directory";
    private const string _acmeAccount = """
        curl -s http://HOMECA:5080/api/v1/acme/accounts \
          -H 'Content-Type: application/json' \
          -d '{"contact":"admin@lab.example.com"}'
