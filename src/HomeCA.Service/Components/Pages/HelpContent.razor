    // ── ACME ─────────────────────────────────────────────────────────────────
    private RenderFragment AcmeHelp => @<div class="help-content">
        <MudText Typo="Typo.h4" Class="mt-2 mb-3">ACME-Einrichtung</MudText>
        <MudText Class="mud-text-secondary mb-4">HomeCA bietet zwei ACME-Betriebsarten: einen internen ACME-Server, der Zertifikate über die eigene TLS Issuing CA ausstellt, und eine verwaltete Registrierung für externe ACME-Aussteller (z. B. Let's Encrypt) mit DNS-01-Challenges.</MudText>

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">1. Interner ACME-Server</MudText>
        <MudText>Der interne ACME-Server stellt Zertifikate für DNS-Namen aus, die unter einer aktivierten internen Ausstellungszone liegen. Orders gehen direkt in den Status <code>ready</code>, da alle Clients als vertrauenswürdig gelten.</MudText>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">1.1 Ausstellungszone anlegen</MudText>
        <MudText>Lege unter <strong>Einstellungen</strong> eine Domain mit aktivierter interner Ausstellung an. Der ACME-Server stellt Zertifikate für alle Namen aus, die exakt der Zone entsprechen oder eine Subdomain davon sind.</MudText>
        <MudTextField Value="@_acmeZone" Lines="4" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/domains" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">1.2 Directory abrufen</MudText>
        <MudText>Der Directory-Endpunkt ist ohne Authentifizierung erreichbar:</MudText>
        <MudTextField Value="@_acmeDirectory" Lines="1" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">1.3 ACME-Account registrieren</MudText>
        <MudTextField Value="@_acmeAccount" Lines="3" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/acme/accounts" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">1.4 Order erstellen</MudText>
        <MudTextField Value="@_acmeOrder" Lines="4" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/acme/orders" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">1.5 Order finalisieren</MudText>
        <MudTextField Value="@_acmeFinalize" Lines="5" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/acme/orders/{id}/finalize" />
        <MudSimpleTable Dense="true" Bordered="true" Class="my-3">
            <thead><tr><th>Parameter</th><th>Standard</th><th>Erklärung</th></tr></thead>
            <tbody>
                <tr><td><code>validityDays</code></td><td>365</td><td>1 bis 730 Tage</td></tr>
                <tr><td><code>keyAlgorithm</code></td><td><code>ECC</code></td><td><code>ECC</code> (P-256) oder <code>RSA</code></td></tr>
                <tr><td><code>rsaKeySize</code></td><td>2048</td><td>Nur bei RSA: 2048 oder 3072</td></tr>
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">2. Externe ACME-Aussteller</MudText>
        <MudText>Externe ACME-Aussteller verweisen auf die Directory-URL einer öffentlichen CA. Die DNS-01-Challenge-Verwaltung wird über einen DNS-Connector abgewickelt.</MudText>

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">2.1 DNS-Connector einrichten</MudText>
        <MudText>Richte unter <strong>Einstellungen</strong> eine Connector-Instanz ein. Unterstützte Typen: <code>technitium</code> und <code>hetzner</code>.</MudText>
        <MudTextField Value="@_acmeConnector" Lines="6" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/connectors" />

        <MudText Typo="Typo.h6" Class="mt-3 mb-2">2.2 Externen Aussteller registrieren</MudText>
        <MudTextField Value="@_acmeIssuer" Lines="5" ReadOnly="true" Variant="Variant.Outlined" Class="script-preview my-3" Label="POST /api/v1/acme/external-issuers" />

        <MudText Typo="Typo.h5" Class="mt-6 mb-2">3. Tipps zur Betriebsführung</MudText>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Warning"><strong>Ablaufwarnungen:</strong> <code>GET /api/v1/warnings/expiring</code> liefert Zertifikate, die innerhalb von 30 Tagen ablaufen.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Backup"><strong>Backup:</strong> Nach jeder ACME-Einrichtung ein verifiziertes Backup erzeugen — siehe Bereich „Betrieb".</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.DomainDisabled"><strong>Zonenänderungen:</strong> Wird eine Zone deaktiviert, lehnt der ACME-Server neue Orders ab. Bestehende Zertifikate bleiben gültig.</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Dns"><strong>Connector-Test:</strong> Nach dem Anlegen eines DNS-Connectors den Berechtigungs- und TXT-Test ausführen, bevor ein externer Aussteller zugewiesen wird.</MudListItem>
        </MudList>
    </div>;

    // ── Code-Schnipsel ───────────────────────────────────────────────────────

    // TLS
    private const string _tlsApiIssue = """
        curl -s http://HOMECA:5080/api/v1/certificates \
          -H "Authorization: Bearer $TOKEN" \
          -H 'Content-Type: application/json' \
          -d '{
            "usage": "TLS",
            "dnsNames": ["app.home.lab", "api.home.lab"],
            "ipAddresses": ["192.168.1.10"],
            "validityDays": 365,
            "keyAlgorithm": "ECC",
            "targetProfileId": "generic-tls"
          }'
        """;
    private const string _tlsApiExports = """
        # Serverzertifikat
        curl -s -o certificate.pem -H "Authorization: Bearer $TOKEN" http://HOMECA:5080/api/v1/certificates/<id>/export/pem
        # Privater Schlüssel
        curl -s -o key.pem -H "Authorization: Bearer $TOKEN" http://HOMECA:5080/api/v1/certificates/<id>/export/key
        # CA-Kette
        curl -s -o chain.pem -H "Authorization: Bearer $TOKEN" http://HOMECA:5080/api/v1/certificates/<id>/export/chain
        # Fullchain
        curl -s -o fullchain.pem -H "Authorization: Bearer $TOKEN" http://HOMECA:5080/api/v1/certificates/<id>/export/fullchain
        # Bundle (HAProxy)
        curl -s -o bundle.pem -H "Authorization: Bearer $TOKEN" http://HOMECA:5080/api/v1/certificates/<id>/export/bundle
        """;
    private const string _tlsApiRenewal = """
        curl -s http://HOMECA:5080/api/v1/renewal-plans \
          -H "Authorization: Bearer $TOKEN" \
          -H 'Content-Type: application/json' \
          -d '{
            "certificateId": "<zertifikat-id>",
            "renewBeforeDays": 30,
            "enabled": true
          }'
        """;
    private const string _tlsApiRevoke = """
        curl -s -X DELETE "http://HOMECA:5080/api/v1/certificates/<id>?reason=keyCompromise" \
          -H "Authorization: Bearer $TOKEN"
        """;
    private const string _tlsDeployProxmox = """
        scp certificate.pem root@pve:/etc/pve/local/pveproxy-ssl.pem
        scp key.pem root@pve:/etc/pve/local/pveproxy-ssl.key
        ssh root@pve "systemctl restart pveproxy"
        """;
    private const string _tlsDeployNginx = """
        cp fullchain.pem /etc/nginx/ssl/fullchain.pem
        cp key.pem /etc/nginx/ssl/key.pem
        nginx -t && systemctl reload nginx

        # nginx-Konfiguration:
        # ssl_certificate     /etc/nginx/ssl/fullchain.pem;
        # ssl_certificate_key /etc/nginx/ssl/key.pem;
        """;
    private const string _tlsDeployHaproxy = """
        # Bundle-Export direkt verwenden:
        cp bundle.pem /etc/haproxy/certs/app.pem
        systemctl reload haproxy
        """;
    private const string _tlsDeployIis = """
        # PFX importieren
        $cert = Import-PfxCertificate -FilePath certificate.pfx -CertStoreLocation Cert:\LocalMachine\My

        # IIS-Bindung zuweisen
        Import-Module WebAdministration
        New-WebBinding -Name "Default Web Site" -Protocol https -Port 443 -HostHeader app.home.lab
        $binding = Get-WebBinding -Name "Default Web Site" -Protocol https
        $binding.AddSslCertificate($cert.Thumbprint, "My")
        """;
    private const string _tlsDeployRdp = """
        $cert = Import-PfxCertificate -FilePath certificate.pfx -CertStoreLocation Cert:\LocalMachine\My
        $path = (Get-WmiObject -Class Win32_TSGeneralSetting -Namespace root\cimv2\TerminalServices)
        $path.SetSSLCertificateSHA1Hash($cert.Thumbprint)
        """;
    private const string _tlsDeployHomeAssistant = """
        # configuration.yaml ergänzen:
        http:
          ssl_certificate: /ssl/certificate.pem
          ssl_key: /ssl/key.pem

        # Dann: ha core restart
        """;
    private const string _tlsDeployUnifi = """
        openssl pkcs12 -export -in certificate.pem -inkey key.pem \
          -out unifi.p12 -name unifi -password pass:aircontrolenterprise
        keytool -importkeystore -srckeystore unifi.p12 -srcstoretype PKCS12 \
          -srcstorepass aircontrolenterprise -destkeystore /var/lib/unifi/keystore \
          -deststorepass aircontrolenterprise -noprompt
        systemctl restart unifi
        """;
    private const string _tlsDeployCisco = """
        conf t
        no crypto pki certificate chain HOMECA
        crypto pki import HOMECA pkcs12 terminal password <pfx-kennwort>
        ! Base64-kodierten PFX-Inhalt einfügen
        end
        write memory
        """;
    private const string _tlsDeployTeamCity = """
        keytool -importkeystore -srckeystore certificate.pfx -srcstoretype PKCS12 \
          -destkeystore /opt/teamcity/conf/keystore.jks -deststoretype JKS \
          -deststorepass changeit -noprompt
        systemctl restart teamcity
        """;

    // SSH
    private const string _sshApiHost = """
        # Host-Key vom Zielserver holen
        PUBKEY=$(ssh-keyscan -t ed25519 webserver.home.lab 2>/dev/null | awk '{print $2" "$3}')

        curl -s http://HOMECA:5080/api/v1/ssh-certificates \
          -H "Authorization: Bearer $TOKEN" \
          -H 'Content-Type: application/json' \
          -d "{
            \"kind\": \"host\",
            \"identity\": \"webserver.home.lab\",
            \"principals\": [\"webserver.home.lab\", \"webserver\"],
            \"publicKey\": \"$PUBKEY\",
            \"validityDays\": 365
          }"
        """;
    private const string _sshApiUser = """
        PUBKEY=$(cat ~/.ssh/id_ed25519.pub)

        curl -s http://HOMECA:5080/api/v1/ssh-certificates \
          -H "Authorization: Bearer $TOKEN" \
          -H 'Content-Type: application/json' \
          -d "{
            \"kind\": \"user\",
            \"identity\": \"max.mustermann\",
            \"principals\": [\"deploy\", \"admin\"],
            \"publicKey\": \"$PUBKEY\",
            \"validityDays\": 90
          }"
        """;
    private const string _sshTrustHost = """
        # Einzelner Benutzer — alle Hosts in *.home.lab vertrauen
        echo "@cert-authority *.home.lab $(cat ssh-host-ca.pub)" >> ~/.ssh/known_hosts

        # Systemweit (alle Benutzer)
        echo "@cert-authority *.home.lab $(cat ssh-host-ca.pub)" | sudo tee -a /etc/ssh/ssh_known_hosts
        """;
    private const string _sshTrustUser = """
        # User-CA-Schlüssel auf den Server kopieren
        sudo cp ssh-user-ca.pub /etc/ssh/trusted-user-ca.pub
        sudo chmod 644 /etc/ssh/trusted-user-ca.pub

        # /etc/ssh/sshd_config ergänzen:
        # TrustedUserCAKeys /etc/ssh/trusted-user-ca.pub

        sudo systemctl reload sshd
        """;
    private const string _sshDeployHost = """
        # Zertifikat auf den Server schreiben
        echo 'ssh-ed25519-cert-v01@openssh.com AAAA...' \
          | sudo tee /etc/ssh/ssh_host_ed25519_key-cert.pub
        sudo chmod 644 /etc/ssh/ssh_host_ed25519_key-cert.pub

        # /etc/ssh/sshd_config ergänzen:
        # HostCertificate /etc/ssh/ssh_host_ed25519_key-cert.pub

        sudo systemctl reload sshd
        """;
    private const string _sshDeployUser = """
        # Zertifikat neben dem privaten Schlüssel speichern
        echo 'ssh-ed25519-cert-v01@openssh.com AAAA...' > ~/.ssh/id_ed25519-cert.pub

        # Verbindung testen
        ssh -v deploy@webserver.home.lab
        """;
    private const string _sshPrincipals = """
        # Verzeichnis anlegen
        sudo mkdir -p /etc/ssh/auth_principals

        # Für jeden Benutzer eine Datei mit erlaubten Principals:
        # /etc/ssh/auth_principals/deploy
        echo -e "deploy\nadmin" | sudo tee /etc/ssh/auth_principals/deploy

        # /etc/ssh/sshd_config ergänzen:
        # AuthorizedPrincipalsFile /etc/ssh/auth_principals/%u

        sudo systemctl reload sshd
        """;

    // Trust
    private const string _trustDownload = """
        # PEM-Format (Linux, macOS, Firefox, Appliances)
        curl -o homeca-root-ca.pem http://HOMECA:5080/api/v1/trust-anchor/pem

        # DER-Format (Windows .cer)
        curl -o homeca-root-ca.cer http://HOMECA:5080/api/v1/trust-anchor/der
        """;
    private const string _trustWindows = "certutil -addstore -f \"Root\" homeca-root-ca.cer";
    private const string _trustLinux = """
        sudo cp homeca-root-ca.pem /usr/local/share/ca-certificates/homeca-root-ca.crt
        sudo update-ca-certificates
        """;
    private const string _trustMacOs = "sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain homeca-root-ca.pem";
    private const string _trustFirefox = """
        {
          "policies": {
            "Certificates": {
              "ImportEnterpriseRoots": true,
              "Install": ["http://HOMECA:5080/api/v1/trust-anchor/pem"]
            }
          }
        }
        """;
    private const string _trustCisco = """
        conf t
        crypto pki trustpoint HOMECA
         enrollment terminal
         revocation-check none
        exit
        crypto pki authenticate HOMECA
        ! PEM-Inhalt einfügen und mit quit bestätigen
        """;
    private const string _trustHuawei = """
        system-view
        pki realm homeca
         ca-certificate import file homeca-root-ca.pem
        """;
    private const string _trustProxmox = """
        scp homeca-root-ca.pem root@pve-node:/usr/local/share/ca-certificates/homeca-root-ca.crt
        ssh root@pve-node "update-ca-certificates"
        """;
    private const string _trustVerify = """
        # Linux: OpenSSL gegen einen HomeCA-gesicherten Dienst testen
        openssl s_client -connect dienst.home.lab:443 -CApath /etc/ssl/certs

        # Fingerprint prüfen
        curl -s http://HOMECA:5080/api/v1/trust-anchor | python3 -m json.tool
        """;

    // ACME
    private const string _acmeZone = """
        curl -s http://HOMECA:5080/api/v1/domains \
