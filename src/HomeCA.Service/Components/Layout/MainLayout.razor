@inherits LayoutComponentBase
@using System.Reflection
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@* Lets brand images pick the matching variant *@
<CascadingValue Value="_isDarkMode" Name="IsDarkMode">
    @Body
</CascadingValue>
<MudTooltip Text="@ThemeToggleLabel">
    <MudIconButton Class="theme-toggle"
                   Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   Color="Color.Inherit"
                   aria-label="@ThemeToggleLabel"
                   OnClick="ToggleDarkMode" />
</MudTooltip>
<MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4 mb-2" Style="opacity: 0.5;">
    HomeCA @_version
</MudText>

@code {
    private string _version = string.Empty;
    private bool _isDarkMode;
    private string ThemeToggleLabel => _isDarkMode ? Text["EnableLightTheme"] : Text["EnableDarkTheme"];

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            // Brand hues from design/, lightness-adjusted to clear 4.5:1 on Surface.
            Primary = "#024381",
            Secondary = "#64748B",
            Tertiary = "#048484",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1E293B",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#475569",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
            Divider = "#E2E8F0",
            ActionDefault = "#475569",
            ActionDisabled = "#CBD5E1",
            Success = "#278834",
            // Brand amber is 1.73:1 on white and goes olive when darkened.
            Warning = "#D97706",
            Error = "#DC2626",
            Info = "#0284C7"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#047FF5",
            Secondary = "#94A3B8",
            Tertiary = "#049595",
            AppbarBackground = "#0F172A",
            AppbarText = "#F8FAFC",
            DrawerBackground = "#0F172A",
            DrawerText = "#CBD5E1",
            Background = "#020617",
            Surface = "#111827",
            TextPrimary = "#F8FAFC",
            TextSecondary = "#94A3B8",
            Divider = "#334155",
            ActionDefault = "#CBD5E1",
            ActionDisabled = "#475569",
            // Brand green and amber are already legible here, so used unmodified.
            Success = "#30A63F",
            Warning = "#FCBA03",
            Error = "#F87171",
            Info = "#38BDF8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "4px"
        }
    };

    protected override void OnInitialized()
    {
        var informational = Assembly.GetEntryAssembly()?
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown";
        _version = informational.Split('+')[0];
    }

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
}
