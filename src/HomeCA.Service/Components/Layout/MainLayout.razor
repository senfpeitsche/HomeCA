@inherits LayoutComponentBase
@using System.Reflection
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeCA.Service.Resources.UiText> Text
@inject IJSRuntime JS

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
@* Read by the brand images and the appearance menu *@
<CascadingValue Value="_isDarkMode" Name="IsDarkMode">
    <CascadingValue Value="_themeContext" Name="Theme">
        @Body
    </CascadingValue>
</CascadingValue>
<footer class="app-footer">
    <MudText Typo="Typo.caption">HomeCA @_version</MudText>
</footer>

@code {
    private string _version = string.Empty;
    private bool _isDarkMode;
    private MudThemeProvider? _themeProvider;
    private ThemeContext _themeContext = null!;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            // Brand hues from design/, lightness-adjusted to clear 4.5:1 on Surface.
            Primary = "#024381",
            Secondary = "#64748B",
            Tertiary = "#048484",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1E293B",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#475569",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
            Divider = "#E2E8F0",
            ActionDefault = "#475569",
            ActionDisabled = "#CBD5E1",
            Success = "#278834",
            // Brand amber is 1.73:1 on white and goes olive when darkened.
            Warning = "#D97706",
            Error = "#DC2626",
            Info = "#0284C7"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#047FF5",
            Secondary = "#94A3B8",
            Tertiary = "#049595",
            AppbarBackground = "#0F172A",
            AppbarText = "#F8FAFC",
            DrawerBackground = "#0F172A",
            DrawerText = "#CBD5E1",
            Background = "#020617",
            Surface = "#111827",
            TextPrimary = "#F8FAFC",
            TextSecondary = "#94A3B8",
            Divider = "#334155",
            ActionDefault = "#CBD5E1",
            ActionDisabled = "#475569",
            // Brand green and amber are already legible here, so used unmodified.
            Success = "#30A63F",
            Warning = "#FCBA03",
            Error = "#F87171",
            Info = "#38BDF8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "4px"
        }
    };

    protected override void OnInitialized()
    {
        var informational = Assembly.GetEntryAssembly()?
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown";
        _version = informational.Split('+')[0];
        _themeContext = new ThemeContext { SetPreferenceAsync = ApplyPreferenceAsync };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // localStorage is unreachable during prerender, so the stored preference
        // can only be read once the circuit is live.
        var stored = await JS.InvokeAsync<string?>("homeca.getThemePreference");
        _themeContext.Preference = ThemeContext.Parse(stored);

        // Track the browser even when it is not the active preference: switching
        // to System later should then apply immediately rather than after a reload.
        if (_themeProvider is not null)
        {
            await _themeProvider.WatchSystemDarkModeAsync(OnSystemThemeChangedAsync);
        }

        await ResolveAsync(persist: false);
    }

    private async Task ApplyPreferenceAsync(ThemePreference preference)
    {
        _themeContext.Preference = preference;
        await ResolveAsync(persist: true);
    }

    private async Task OnSystemThemeChangedAsync(bool systemIsDark)
    {
        if (_themeContext.Preference != ThemePreference.System) return;
        _isDarkMode = systemIsDark;
        _themeContext.IsDark = systemIsDark;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResolveAsync(bool persist)
    {
        _isDarkMode = _themeContext.Preference switch
        {
            ThemePreference.Light => false,
            ThemePreference.Dark => true,
            _ => _themeProvider is not null && await _themeProvider.GetSystemDarkModeAsync()
        };
        _themeContext.IsDark = _isDarkMode;

        if (persist)
        {
            await JS.InvokeVoidAsync("homeca.setThemePreference", ThemeContext.Serialize(_themeContext.Preference));
        }

        StateHasChanged();
    }
}
