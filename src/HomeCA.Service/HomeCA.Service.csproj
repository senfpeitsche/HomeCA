<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="8.12.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- SSH.NET brings BouncyCastle 2; the alias keeps its types apart from the BouncyCastle 1.9 that Certes uses. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" Aliases="BouncyCastleCryptography" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../profiles/profiles.json" Link="profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Help\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HomeCA.Tests" />
  </ItemGroup>

</Project>
